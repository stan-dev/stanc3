(executable
 (name stanc)
 (modes
  (byte c)
  (best exe))
 (libraries
  base
  stdio
  fmt
  cmdliner
  fmt.cli
  fmt.tty
  driver
  stan_math_signatures)
 (instrumentation
  (backend bisect_ppx))
 (modules Stanc CLI)
 (public_name stanc)
 (package stanc)
 (preprocess
  (pps ppx_base ppx_pipebang ppx_sexp_message ppx_sexp_value)))

(rule
 (target
  (dir cmdliner-support))
 (deps stanc.exe)
 (action
  (ignore-stdout
   (run cmdliner install tool-support ./stanc.exe:stanc cmdliner-support))))

(install
 (section share_root)
 (package stanc)
 (dirs
  (cmdliner-support/share as .)))
