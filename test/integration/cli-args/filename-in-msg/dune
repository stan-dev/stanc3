(rule
 (targets filename_error.output)
 (deps
  (package stanc)
  (:stanfiles filename_error.stan filename_syntax_error.stan includes.stan))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/run_bin_on_args.exe
    "%{bin:stanc} --filename-in-msg=foo.stan --include-paths=. "
    %{stanfiles}))))

(rule
 (alias runtest)
 (action
  (diff filename_error.expected filename_error.output)))

(rule
 (targets cpp.inc.gen)
 (deps
  (:stanfiles filename_good.stan empty.stan))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/gen_expected_rules.exe
    cpp
    cpp
    "--filename-in-msg=foo.stan --include-paths=. --print-cpp "
    %{stanfiles}))))

(rule
 (alias update-rules)
 (action
  (diff expected_cpp/dune.inc cpp.inc.gen)))

(include expected_cpp/dune.inc)
