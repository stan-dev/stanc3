(subdir
 dunes
 (rule
  (deps
   (sandbox patch_back_source_tree)
   (glob_files ../expected_standalone_cpp/*)
   (:stanfiles
    (glob_files ../*.stan)
    (glob_files ../*.stanfunctions)))
  (action
   (with-stdout-to
    standalone_cpp.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     standalone_cpp
     cpp
     "--standalone-functions --allow-undefined --print-cpp"
     %{stanfiles}))))
 (rule
  (deps
   (sandbox patch_back_source_tree)
   (glob_files ../expected_cpp/*)
   (:stanfiles
    (glob_files ../*.stan)
    (glob_files ../*.stanfunctions)))
  (action
   (with-stdout-to
    cpp.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     cpp
     "--allow-undefined --print-cpp"
     %{stanfiles})))))

(subdir
 run
 (dynamic_include ../dunes/cpp.dune)
 (dynamic_include ../dunes/standalone_cpp.dune))
