(rule
 (targets standalone_cpp.inc.gen)
 (deps
  (:stanfiles
   (glob_files *.stan)
   (glob_files *.stanfunctions)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/gen_expected_rules.exe
    standalone_cpp
    cpp
    "--standalone-functions --allow-undefined --print-cpp"
    %{stanfiles}))))

(rule
 (alias update-rules)
 (action
  (diff expected_standalone_cpp/dune.inc standalone_cpp.inc.gen)))

(include expected_standalone_cpp/dune.inc)

(rule
 (targets cpp.inc.gen)
 (deps
  (:stanfiles
   (glob_files *.stan)
   (glob_files *.stanfunctions)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/gen_expected_rules.exe
    cpp
    cpp
    "--allow-undefined --print-cpp"
    %{stanfiles}))))

(rule
 (alias update-rules)
 (action
  (diff expected_cpp/dune.inc cpp.inc.gen)))

(include expected_cpp/dune.inc)
