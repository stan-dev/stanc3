(subdir
 dunes
 (rule
  (deps
   (:inc
    (glob_files ../*.inc))
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    pretty.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--auto-format --include-paths=.."
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    inlined.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--auto-format --include-paths=.. --canonicalize=includes"
     %{stanfiles})))))

(subdir
 expected_pretty
 (dynamic_include ../dunes/pretty.dune))

(subdir
 expected_inlined
 (dynamic_include ../dunes/inlined.dune))
