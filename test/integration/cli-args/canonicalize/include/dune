(subdir
 dunes
 (rule
  (deps
   (sandbox patch_back_source_tree)
   (glob_files ../expected_pretty/*)
   (:inc
    (glob_files ../*.inc))
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    pretty.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--auto-format --include-paths=.."
     %{stanfiles}))))
 (rule
  (deps
   (sandbox patch_back_source_tree)
   (glob_files ../expected_inlined/*)
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    inlined.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--auto-format --include-paths=.. --canonicalize=includes"
     %{stanfiles})))))

(subdir
 run
 (dynamic_include ../dunes/pretty.dune)
 (dynamic_include ../dunes/inlined.dune))
