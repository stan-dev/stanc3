(subdir
 dunes
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    canonical.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--print-canonical"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    deprecations.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--auto-format --canonicalize deprecations"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    everything-but.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--auto-format --canonicalize braces,parentheses"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    stripped.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--auto-format --canonicalize strip-comments,braces,parentheses,deprecations"
     %{stanfiles})))))

(subdir
 expected_canonical
 (dynamic_include ../dunes/canonical.dune))

(subdir
 expected_deprecations
 (dynamic_include ../dunes/deprecations.dune))

(subdir
 expected_everything_but
 (dynamic_include ../dunes/everything-but.dune))

(subdir
 expected_stripped
 (dynamic_include ../dunes/stripped.dune))
