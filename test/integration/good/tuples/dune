(rule
 (targets cpp.inc.gen)
 (deps
  (:stanfiles
   (glob_files *.stan)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/gen_expected_rules.exe
    cpp
    cpp
    "-fsoa --print-cpp"
    %{stanfiles}))))

(rule
 (alias update-rules)
 (action
  (diff expected_cpp/dune.inc cpp.inc.gen)))

(include expected_cpp/dune.inc)

(rule
 (targets optimized_mir.inc.gen)
 (deps
  (:stanfiles
   (glob_files *.stan)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/gen_expected_rules.exe
    optimized_mir
    mir
    "-fsoa --debug-optimized-mir"
    %{stanfiles}))))

(rule
 (alias update-rules)
 (action
  (diff expected_optimized_mir/dune.inc optimized_mir.inc.gen)))

(include expected_optimized_mir/dune.inc)

(rule
 (targets pretty.output)
 (deps
  (package stanc)
  (:stanfiles
   (glob_files *.stan)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/run_bin_on_args.exe
    "%{bin:stanc} --auto-format"
    %{stanfiles}))))

(rule
 (alias runtest)
 (action
  (diff pretty.expected pretty.output)))
