(rule
 (targets pretty.output)
 (deps
  (package stanc)
  (:stanfiles
   (glob_files *.stan)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/run_bin_on_args.exe
    "%{bin:stanc} --auto-format"
    %{stanfiles}))))

(rule
 (alias runtest)
 (action
  (diff pretty.expected pretty.output)))

(subdir
 dunes
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    cpp.inc
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "-fsoa --print-cpp"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    mir.inc
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     mir
     "-fsoa --debug-optimized-mir"
     %{stanfiles})))))

(subdir
 expected_cpp
 (dynamic_include ../dunes/cpp.inc))

(subdir
 expected_optimized_mir
 (dynamic_include ../dunes/mir.inc))
