/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../invariant_read_first_written_tsvc_s293.stan : [exit 0] */
input_vars {
  int N;
  vector[(N + 1)] a0; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  FnReadData__(a0, context__, "a0"); }

log_prob {
  {
    data int a4_1dim__ = (N + 1);
    FnValidateSize__("a4", "N + 1", a4_1dim__);
    vector[a4_1dim__] a4;
    a4 = a0;
    for(n in 1:N) {
      a4[n] = a4[1];
    }
    target += sum(a4);
  } }

rev_log_prob {
  {
    data int a4_1dim__ = (N + 1);
    FnValidateSize__("a4", "N + 1", a4_1dim__);
    vector[a4_1dim__] a4;
    a4 = a0;
    for(n in 1:N) {
      a4[n] = a4[1];
    }
    target += sum(a4);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

