/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../scalar_carried_previous_element_tsvc_s254.stan : [exit 0] */
input_vars {
  int N;
  vector[N] a0;
  vector[N] b; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b"); }

log_prob {
  {
    FnValidateSize__("a3", "N", N);
    vector[N] a3;
    a3 = a0;
    real x3;
    x3 = promote(0, real, var);
    for(n in 1:N) {
      a3[n] = ((b[n] + x3) * 0.5);
      x3 = b[n];
    }
    target += (sum(a3) + x3);
  } }

rev_log_prob {
  {
    FnValidateSize__("a3", "N", N);
    vector[N] a3;
    a3 = a0;
    real x3;
    x3 = promote(0, real, var);
    for(n in 1:N) {
      a3[n] = ((b[n] + x3) * 0.5);
      x3 = b[n];
    }
    target += (sum(a3) + x3);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

