/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../scalar_induction_variable_tsvc_s453.stan : [exit 0] */
input_vars {
  int N;
  vector[N] a0;
  vector[N] b; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b"); }

log_prob {
  {
    FnValidateSize__("a6", "N", N);
    vector[N] a6;
    a6 = a0;
    real s6;
    s6 = promote(0, real, var);
    for(n in 1:N) {
      s6 = (s6 + 2);
      a6[n] = (s6 * b[n]);
    }
    target += sum(a6);
  } }

rev_log_prob {
  {
    FnValidateSize__("a6", "N", N);
    vector[N] a6;
    a6 = a0;
    real s6;
    s6 = promote(0, real, var);
    for(n in 1:N) {
      s6 = (s6 + 2);
      a6[n] = (s6 * b[n]);
    }
    target += sum(a6);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

