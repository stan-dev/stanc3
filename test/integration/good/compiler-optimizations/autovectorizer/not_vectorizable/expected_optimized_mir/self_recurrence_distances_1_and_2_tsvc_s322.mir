/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../self_recurrence_distances_1_and_2_tsvc_s322.stan : [exit 0] */
input_vars {
  int N;
  vector[N] a0;
  vector[N] b;
  vector[N] c; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 3))(var_name N)(var N))__(3);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c"); }

log_prob {
  {
    FnValidateSize__("a2", "N", N);
    vector[N] a2;
    a2 = a0;
    for(n in 3:N) {
      a2[n] = ((a2[n] + (a2[(n - 1)] * b[n])) + (a2[(n - 2)] * c[n]));
    }
    target += sum(a2);
  } }

rev_log_prob {
  {
    FnValidateSize__("a2", "N", N);
    vector[N] a2;
    a2 = a0;
    for(n in 3:N) {
      a2[n] = ((a2[n] + (a2[(n - 1)] * b[n])) + (a2[(n - 2)] * c[n]));
    }
    target += sum(a2);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

