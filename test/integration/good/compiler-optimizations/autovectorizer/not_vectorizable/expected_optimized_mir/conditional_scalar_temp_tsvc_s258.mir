/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../conditional_scalar_temp_tsvc_s258.stan : [exit 0] */
input_vars {
  int N;
  vector[N] a0;
  vector[N] b;
  vector[N] c;
  vector[N] d; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c");
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  FnReadData__(d, context__, "d"); }

log_prob {
  {
    real s4;
    s4 = promote(0, real, var);
    FnValidateSize__("b4", "N", N);
    vector[N] b4;
    b4 = b;
    for(n in 1:N) {
      if((a0[n] > 0)) {
        s4 = (d[n] * d[n]);
      }
      b4[n] = ((s4 * c[n]) + d[n]);
    }
    target += sum(b4);
  } }

rev_log_prob {
  {
    real s4;
    s4 = promote(0, real, var);
    FnValidateSize__("b4", "N", N);
    vector[N] b4;
    b4 = b;
    for(n in 1:N) {
      if((a0[n] > 0)) {
        s4 = (d[n] * d[n]);
      }
      b4[n] = ((s4 * c[n]) + d[n]);
    }
    target += sum(b4);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

