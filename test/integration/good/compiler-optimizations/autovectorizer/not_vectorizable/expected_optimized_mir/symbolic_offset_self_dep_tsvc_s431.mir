/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../symbolic_offset_self_dep_tsvc_s431.stan : [exit 0] */
input_vars {
  int N;
  int k;
  vector[(N + k)] a0k;
  vector[N] b; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int k;
  FnReadData__(k, context__, "k");
  (FnCheck(trans(Lower 0))(var_name k)(var k))__(0);
  data int a0k_1dim__ = (N + k);
  FnValidateSize__("a0k", "N + k", a0k_1dim__);
  data vector[a0k_1dim__] a0k;
  FnReadData__(a0k, context__, "a0k");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b"); }

log_prob {
  {
    data int a6_1dim__ = (N + k);
    FnValidateSize__("a6", "N + k", a6_1dim__);
    vector[a6_1dim__] a6;
    a6 = a0k;
    for(n in 1:N) {
      a6[n] = (a6[(n + k)] + b[n]);
    }
    target += sum(a6);
  } }

rev_log_prob {
  {
    data int a6_1dim__ = (N + k);
    FnValidateSize__("a6", "N + k", a6_1dim__);
    vector[a6_1dim__] a6;
    a6 = a0k;
    for(n in 1:N) {
      a6[n] = (a6[(n + k)] + b[n]);
    }
    target += sum(a6);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

