/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../target_read_blocks_density_widening.stan : [exit 0] */
input_vars {
  int N;
  vector[N] x;
  row_vector[N] y; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 0))(var_name N)(var N))__(0);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x");
  FnValidateSize__("y", "N", N);
  data row_vector[N] y;
  FnReadData__(y, context__, "y"); }

log_prob {
  {
    for(i in 1:N) {
      target += std_normal_lupdf(x[i]);
      for(j in 1:N) {
        target += std_normal_lupdf(y[i]);
        FnPrint__(target());
      }
    }
  } }

rev_log_prob {
  {
    for(i in 1:N) {
      target += std_normal_lupdf(x[i]);
      for(j in 1:N) {
        target += std_normal_lupdf(y[i]);
        FnPrint__(target());
      }
    }
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

