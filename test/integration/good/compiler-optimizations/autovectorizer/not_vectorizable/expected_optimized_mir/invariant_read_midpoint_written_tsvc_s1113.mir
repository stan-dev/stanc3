/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../invariant_read_midpoint_written_tsvc_s1113.stan : [exit 0] */
input_vars {
  int N;
  vector[(N + 1)] a0;
  vector[N] b; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b"); }

log_prob {
  {
    data int a3_1dim__ = (N + 1);
    FnValidateSize__("a3", "N + 1", a3_1dim__);
    vector[a3_1dim__] a3;
    a3 = a0;
    for(n in 1:N) {
      a3[n] = (a3[(N %/% 2)] + b[n]);
    }
    target += sum(a3);
  } }

rev_log_prob {
  {
    data int a3_1dim__ = (N + 1);
    FnValidateSize__("a3", "N + 1", a3_1dim__);
    vector[a3_1dim__] a3;
    a3 = a0;
    for(n in 1:N) {
      a3[n] = (a3[(N %/% 2)] + b[n]);
    }
    target += sum(a3);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

