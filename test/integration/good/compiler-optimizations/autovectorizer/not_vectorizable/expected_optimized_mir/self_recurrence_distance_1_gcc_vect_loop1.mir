/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../self_recurrence_distance_1_gcc_vect_loop1.stan : [exit 0] */
input_vars {
  int N; }

prepare_data {
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1); }

log_prob {
  {
    data int ia6_1dim__ = (N + 1);
    FnValidateSize__("ia6", "N + 1", ia6_1dim__);
    vector[ia6_1dim__] ia6;
    for(n in 1:N) {
      ia6[(n + 1)] = (ia6[n] * promote(4, real, data));
    }
    target += sum(ia6);
  } }

rev_log_prob {
  {
    data int ia6_1dim__ = (N + 1);
    FnValidateSize__("ia6", "N + 1", ia6_1dim__);
    vector[ia6_1dim__] ia6;
    for(n in 1:N) {
      ia6[(n + 1)] = (ia6[n] * promote(4, real, data));
    }
    target += sum(ia6);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

