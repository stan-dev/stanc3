/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../density_matrix_row_argument_stays_loop.stan : [exit 0] */
input_vars {
  int N;
  matrix[N, 2] m; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 0))(var_name N)(var N))__(0);
  FnValidateSize__("m", "N", N);
  data matrix[N, 2] m;
  FnReadData__(m, context__, "m"); }

log_prob {
  real mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    for(n in 1:N) {
      target += normal_lpdf(m[n], mu, sigma);
    }
  } }

rev_log_prob {
  real mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    for(n in 1:N) {
      target += normal_lpdf(m[n], mu, sigma);
    }
  } }

generate_quantities {
  data real
    mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  data real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var mu))__();
  (FnWriteParam(unconstrain_opt())(var sigma))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real mu;
  FnReadData__(mu, context__, "mu");
  (FnWriteParam(unconstrain_opt(Identity))(var mu))__();
  real sigma;
  FnReadData__(sigma, context__, "sigma");
  (FnWriteParam(unconstrain_opt((Lower 0)))(var sigma))__(); }
output_vars {
  parameters real mu; //real
  parameters real sigma; //real
}
