(subdir
 dunes
 (rule
  (deps
   (sandbox patch_back_source_tree)
   (glob_files ../expected_optimized_mir/*)
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    mir.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     mir
     "-fvectorize-loops --debug-optimized-mir-pretty"
     %{stanfiles})))))

(subdir
 run
 (dynamic_include ../dunes/mir.dune))

(rule
 (alias runtest)
 (enabled_if %{bin-available:grep})
 (deps
  (glob_files expected_optimized_mir/*))
 (action
  (progn
   (with-stdout-to
    vectorized_files.out
    (pipe-stdout
     (run grep "for(" expected_optimized_mir/ -R -L)
     (run sort)))
   (diff? vectorized_files.txt vectorized_files.out))))
