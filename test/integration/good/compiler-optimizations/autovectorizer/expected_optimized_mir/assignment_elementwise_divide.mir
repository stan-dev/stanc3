/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../assignment_elementwise_divide.stan : [exit 0] */
input_vars {
  int N;
  vector[N] x;
  vector[N] w; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 0))(var_name N)(var N))__(0);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x");
  FnValidateSize__("w", "N", N);
  data vector[N] w;
  FnReadData__(w, context__, "w");
  FnValidateSize__("mu", "N", N); }

log_prob {
  vector[N]
    mu = (FnReadParam(constrain(Lower 0))(dims(N))(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("v", "N", N);
    vector[N] v;
    v[1:N] = ((x[1:N] .* w[1:N]) ./ mu[1:N]);
    target += normal_lpdf(v, promote(0, real, data), promote(1, real, data));
  } }

rev_log_prob {
  vector[N]
    mu = (FnReadParam(constrain(Lower 0))(dims(N))(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("v", "N", N);
    vector[N] v;
    v[1:N] = ((x[1:N] .* w[1:N]) ./ mu[1:N]);
    target += normal_lpdf(v, promote(0, real, data), promote(1, real, data));
  } }

generate_quantities {
  data vector[N]
    mu = (FnReadParam(constrain(Lower 0))(dims(N))(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var mu))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  data int pos__;
  pos__ = 1;
  vector[N] mu;
  FnReadData__(mu, context__, "mu");
  (FnWriteParam(unconstrain_opt((Lower 0)))(var mu))__(); }
output_vars {
  parameters vector[N] mu; //vector[N]
}
