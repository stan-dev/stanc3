/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../effectful_call_between_stmts_tsvc_s471.stan : [exit 0] */
functions {
  void foo() {
    {
      FnPrint__("foo");
    }
  } }
input_vars {
  int N;
  vector[N] b0;
  vector[N] c;
  vector[N] d;
  vector[N] e; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("b0", "N", N);
  data vector[N] b0;
  FnReadData__(b0, context__, "b0");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c");
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  FnReadData__(d, context__, "d");
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  FnReadData__(e, context__, "e"); }

log_prob {
  {
    FnValidateSize__("b1", "N", N);
    vector[N] b1;
    b1 = b0;
    FnValidateSize__("x1", "N", N);
    vector[N] x1;
    for(n in 1:N) {
      x1[n] = (b1[n] + (d[n] * d[n]));
      foo();
      b1[n] = (c[n] + (d[n] * e[n]));
    }
    target += (sum(b1) + sum(x1));
  } }

rev_log_prob {
  {
    FnValidateSize__("b1", "N", N);
    vector[N] b1;
    b1 = b0;
    FnValidateSize__("x1", "N", N);
    vector[N] x1;
    for(n in 1:N) {
      x1[n] = (b1[n] + (d[n] * d[n]));
      foo();
      b1[n] = (c[n] + (d[n] * e[n]));
    }
    target += (sum(b1) + sum(x1));
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

