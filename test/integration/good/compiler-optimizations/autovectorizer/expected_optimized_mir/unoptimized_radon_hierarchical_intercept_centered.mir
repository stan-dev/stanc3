/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../unoptimized_radon_hierarchical_intercept_centered.stan : [exit 0] */

input_vars {
  int J;
  int N;
  array[int, N] county_idx;
  vector[N] log_uppm;
  vector[N] floor_measure;
  vector[N] log_radon; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int J;
  FnReadData__(J, context__, "J");
  (FnCheck(trans(Lower 0))(var_name J)(var J))__(0);
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 0))(var_name N)(var N))__(0);
  FnValidateSize__("county_idx", "N", N);
  data array[int, N] county_idx;
  FnReadData__(county_idx, context__, "county_idx");
  (FnCheck(trans(Lower 1))(var_name county_idx)(var county_idx))__(1);
  (FnCheck(trans(Upper J))(var_name county_idx)(var county_idx))__(J);
  FnValidateSize__("log_uppm", "N", N);
  data vector[N] log_uppm;
  FnReadData__(log_uppm, context__, "log_uppm");
  FnValidateSize__("floor_measure", "N", N);
  data vector[N] floor_measure;
  FnReadData__(floor_measure, context__, "floor_measure");
  FnValidateSize__("log_radon", "N", N);
  data vector[N] log_radon;
  FnReadData__(log_radon, context__, "log_radon");
  FnValidateSize__("alpha", "J", J); }

log_prob {
  vector[J]
    alpha = (FnReadParam(constrain Identity)(dims(J))(mem_pattern AoS))__(
    );
  vector[2]
    beta = (FnReadParam(constrain Identity)(dims(2))(mem_pattern AoS))__(
    );
  real
    mu_alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  real
    sigma_alpha = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  real
    sigma_y = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("mu", "N", N);
    vector[N] mu;
    FnValidateSize__("muj", "N", N);
    vector[N] muj;
    target += normal_lupdf(sigma_alpha, promote(0, real, data),
                           promote(1, real, data));
    target += normal_lupdf(sigma_y, promote(0, real, data),
                           promote(1, real, data));
    target += normal_lupdf(mu_alpha, promote(0, real, data),
                           promote(10, real, data));
    target += normal_lupdf(beta, promote(0, real, data),
                           promote(10, real, data));
    target += normal_lupdf(alpha, mu_alpha, sigma_alpha);
    for(n in 1:N) {
      muj[n] = (alpha[county_idx[n]] + (log_uppm[n] * beta[1]));
      mu[n] = (muj[n] + (floor_measure[n] * beta[2]));
      target += normal_lpdf(log_radon[n], mu[n], sigma_y);
    }
  } }

rev_log_prob {
  vector[J]
    alpha = (FnReadParam(constrain Identity)(dims(J))(mem_pattern AoS))__(
    );
  vector[2]
    beta = (FnReadParam(constrain Identity)(dims(2))(mem_pattern AoS))__(
    );
  real
    mu_alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  real
    sigma_alpha = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  real
    sigma_y = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("mu", "N", N);
    vector[N] mu;
    FnValidateSize__("muj", "N", N);
    vector[N] muj;
    target += normal_lupdf(sigma_alpha, promote(0, real, data),
                           promote(1, real, data));
    target += normal_lupdf(sigma_y, promote(0, real, data),
                           promote(1, real, data));
    target += normal_lupdf(mu_alpha, promote(0, real, data),
                           promote(10, real, data));
    target += normal_lupdf(beta, promote(0, real, data),
                           promote(10, real, data));
    target += normal_lupdf(alpha, mu_alpha, sigma_alpha);
    for(n in 1:N) {
      muj[n] = (alpha[county_idx[n]] + (log_uppm[n] * beta[1]));
      mu[n] = (muj[n] + (floor_measure[n] * beta[2]));
      target += normal_lpdf(log_radon[n], mu[n], sigma_y);
    }
  } }

generate_quantities {
  data vector[J]
    alpha = (FnReadParam(constrain Identity)(dims(J))(mem_pattern AoS))__(
    );
  data vector[2]
    beta = (FnReadParam(constrain Identity)(dims(2))(mem_pattern AoS))__(
    );
  data real
    mu_alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  data real
    sigma_alpha = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  data real
    sigma_y = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var alpha))__();
  (FnWriteParam(unconstrain_opt())(var beta))__();
  (FnWriteParam(unconstrain_opt())(var mu_alpha))__();
  (FnWriteParam(unconstrain_opt())(var sigma_alpha))__();
  (FnWriteParam(unconstrain_opt())(var sigma_y))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  data int pos__;
  pos__ = 1;
  vector[J] alpha;
  FnReadData__(alpha, context__, "alpha");
  (FnWriteParam(unconstrain_opt(Identity))(var alpha))__();
  vector[2] beta;
  FnReadData__(beta, context__, "beta");
  (FnWriteParam(unconstrain_opt(Identity))(var beta))__();
  real mu_alpha;
  FnReadData__(mu_alpha, context__, "mu_alpha");
  (FnWriteParam(unconstrain_opt(Identity))(var mu_alpha))__();
  real sigma_alpha;
  FnReadData__(sigma_alpha, context__, "sigma_alpha");
  (FnWriteParam(unconstrain_opt((Lower 0)))(var sigma_alpha))__();
  real sigma_y;
  FnReadData__(sigma_y, context__, "sigma_y");
  (FnWriteParam(unconstrain_opt((Lower 0)))(var sigma_y))__(); }

output_vars {
  parameters vector[J] alpha; //vector[J]
  parameters vector[2] beta; //vector[2]
  parameters real mu_alpha; //real
  parameters real sigma_alpha; //real
  parameters real sigma_y; //real
}
