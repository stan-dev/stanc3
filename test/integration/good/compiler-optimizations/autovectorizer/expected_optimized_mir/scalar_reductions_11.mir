/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../scalar_reductions_11.stan : [exit 0] */
input_vars {
  int N;
  vector[N] a; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  FnValidateSize__("a", "N", N);
  data vector[N] a;
  FnReadData__(a, context__, "a"); }

log_prob {
  {
    real s11;
    s11 = promote(0, real, var);
    for(n in 1:N) {
      if((a[n] > 0)) {
        s11 = (s11 + a[n]);
      }
    }
    target += s11;
  } }

rev_log_prob {
  {
    real s11;
    s11 = promote(0, real, var);
    for(n in 1:N) {
      if((a[n] > 0)) {
        s11 = (s11 + a[n]);
      }
    }
    target += s11;
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

