/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../design_examples_10.stan : [exit 0] */
input_vars {
  int N;
  vector[N] x; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x"); }

log_prob {
  {
    FnValidateSize__("v10", "N", N);
    matrix[N, 2] v10;
    v10 = rep_matrix(promote(0, real, data), N, 2);
    FnValidateSize__("w10", "N", N);
    vector[N] w10;
    for(n in 1:N) {
      v10[n, 1] = x[n];
      w10[n] = v10[n, 2];
    }
    target += (sum(v10) + sum(w10));
  } }

rev_log_prob {
  {
    FnValidateSize__("v10", "N", N);
    matrix[N, 2] v10;
    v10 = rep_matrix(promote(0, real, data), N, 2);
    FnValidateSize__("w10", "N", N);
    vector[N] w10;
    for(n in 1:N) {
      v10[n, 1] = x[n];
      w10[n] = v10[n, 2];
    }
    target += (sum(v10) + sum(w10));
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

