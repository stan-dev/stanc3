/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../assignment_invariant_rhs_stays_loop.stan : [exit 0] */
input_vars {
  int N; }

prepare_data {
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 0))(var_name N)(var N))__(0); }

log_prob {
  real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("v", "N", N);
    vector[N] v;
    for(n in 1:N) {
      v[n] = alpha;
    }
    target += normal_lpdf(v, promote(0, real, data), promote(1, real, data));
  } }

rev_log_prob {
  real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("v", "N", N);
    vector[N] v;
    for(n in 1:N) {
      v[n] = alpha;
    }
    target += normal_lpdf(v, promote(0, real, data), promote(1, real, data));
  } }

generate_quantities {
  data real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var alpha))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real alpha;
  FnReadData__(alpha, context__, "alpha");
  (FnWriteParam(unconstrain_opt(Identity))(var alpha))__(); }
output_vars {
  parameters real alpha; //real
}
