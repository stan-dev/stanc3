/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_linear_dependence_05_s121.stan : [exit 0] */
input_vars {
  int N;
  vector[(N + 1)] a0;
  vector[N] b; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b"); }

log_prob {
  {
    data int a5_1dim__ = (N + 1);
    FnValidateSize__("a5", "N + 1", a5_1dim__);
    vector[a5_1dim__] a5;
    a5 = a0;
    int j5;
    j5 = 1;
    for(n in 1:(N - 1)) {
      a5[n] = (a5[j5] + b[n]);
      j5 = (j5 + 1);
    }
    target += sum(a5);
  } }

rev_log_prob {
  {
    data int a5_1dim__ = (N + 1);
    FnValidateSize__("a5", "N + 1", a5_1dim__);
    vector[a5_1dim__] a5;
    a5 = a0;
    int j5;
    j5 = 1;
    for(n in 1:(N - 1)) {
      a5[n] = (a5[j5] + b[n]);
      j5 = (j5 + 1);
    }
    target += sum(a5);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

