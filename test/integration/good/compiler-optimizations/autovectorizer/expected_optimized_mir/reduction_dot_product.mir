/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../reduction_dot_product.stan : [exit 0] */
input_vars {
  int N;
  vector[N] a;
  vector[N] b; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  FnValidateSize__("a", "N", N);
  data vector[N] a;
  FnReadData__(a, context__, "a");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b"); }

log_prob {
  real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  {
    real dot4;
    dot4 = promote(0, real, var);
    for(n in 1:N) {
      dot4 = (dot4 + (a[n] * b[n]));
    }
    target += (dot4 * alpha);
  } }

rev_log_prob {
  real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  {
    real dot4;
    dot4 = promote(0, real, var);
    for(n in 1:N) {
      dot4 = (dot4 + (a[n] * b[n]));
    }
    target += (dot4 * alpha);
  } }

generate_quantities {
  data real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var alpha))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real alpha;
  FnReadData__(alpha, context__, "alpha");
  (FnWriteParam(unconstrain_opt(Identity))(var alpha))__(); }
output_vars {
  parameters real alpha; //real
}
