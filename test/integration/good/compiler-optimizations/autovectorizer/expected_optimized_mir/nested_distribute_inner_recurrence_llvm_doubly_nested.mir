/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../nested_distribute_inner_recurrence_llvm_doubly_nested.stan : [exit 0] */

input_vars {
  int N;
  int J;
  matrix[N, J] mb;
  matrix[N, J] mc;
  matrix[N, J] me;
  matrix[N, J] mf; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  data int J;
  FnReadData__(J, context__, "J");
  (FnCheck(trans(Lower 1))(var_name J)(var J))__(1);
  FnValidateSize__("mb", "N", N);
  FnValidateSize__("mb", "J", J);
  data matrix[N, J] mb;
  FnReadData__(mb, context__, "mb");
  FnValidateSize__("mc", "N", N);
  FnValidateSize__("mc", "J", J);
  data matrix[N, J] mc;
  FnReadData__(mc, context__, "mc");
  FnValidateSize__("me", "N", N);
  FnValidateSize__("me", "J", J);
  data matrix[N, J] me;
  FnReadData__(me, context__, "me");
  FnValidateSize__("mf", "N", N);
  FnValidateSize__("mf", "J", J);
  data matrix[N, J] mf;
  FnReadData__(mf, context__, "mf"); }

log_prob {
  {
    FnValidateSize__("ma3", "N", N);
    data int ma3_2dim__ = (J + 1);
    FnValidateSize__("ma3", "J + 1", ma3_2dim__);
    matrix[N, ma3_2dim__] ma3;
    FnValidateSize__("md3", "N", N);
    FnValidateSize__("md3", "J", J);
    matrix[N, J] md3;
    for(i in 1:N) {
      md3[i, 1:J] = (me[i, 1:J] .* mf[i, 1:J]);
      for(j in 1:J) {
        ma3[i, (j + 1)] = ((ma3[i, j] + mb[i, j]) + mc[i, j]);
      }
    }
    target += (sum(ma3) + sum(md3));
  } }

rev_log_prob {
  {
    FnValidateSize__("ma3", "N", N);
    data int ma3_2dim__ = (J + 1);
    FnValidateSize__("ma3", "J + 1", ma3_2dim__);
    matrix[N, ma3_2dim__] ma3;
    FnValidateSize__("md3", "N", N);
    FnValidateSize__("md3", "J", J);
    matrix[N, J] md3;
    for(i in 1:N) {
      md3[i, 1:J] = (me[i, 1:J] .* mf[i, 1:J]);
      for(j in 1:J) {
        ma3[i, (j + 1)] = ((ma3[i, j] + mb[i, j]) + mc[i, j]);
      }
    }
    target += (sum(ma3) + sum(md3));
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

