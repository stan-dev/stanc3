/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../llvm_loop_access_05_safe_with_dep_distance.stan : [exit 0] */
input_vars {
  int N; }

prepare_data {
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1); }

log_prob {
  {
    data int a5_1dim__ = (N + 4);
    FnValidateSize__("a5", "N + 4", a5_1dim__);
    vector[a5_1dim__] a5;
    for(n in 1:N) {
      a5[(n + 4)] = (a5[n] * promote(2, real, data));
    }
    target += sum(a5);
  } }

rev_log_prob {
  {
    data int a5_1dim__ = (N + 4);
    FnValidateSize__("a5", "N + 4", a5_1dim__);
    vector[a5_1dim__] a5;
    for(n in 1:N) {
      a5[(n + 4)] = (a5[n] * promote(2, real, data));
    }
    target += sum(a5);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

