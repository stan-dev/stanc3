/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../design_examples_09c.stan : [exit 0] */
input_vars {
  int N;
  vector[N] x; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x"); }

log_prob {
  {
    FnValidateSize__("y9c", "N", N);
    vector[N] y9c;
    for(n in 1:N) {
      vector[2] t9c;
      t9c[1] = x[n];
      y9c[n] = t9c[1];
    }
    target += sum(y9c);
  } }

rev_log_prob {
  {
    FnValidateSize__("y9c", "N", N);
    vector[N] y9c;
    for(n in 1:N) {
      vector[2] t9c;
      t9c[1] = x[n];
      y9c[n] = t9c[1];
    }
    target += sum(y9c);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

