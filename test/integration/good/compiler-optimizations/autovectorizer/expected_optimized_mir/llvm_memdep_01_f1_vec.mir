/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../llvm_memdep_01_f1_vec.stan : [exit 0] */
input_vars {
  int N; }

prepare_data {
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1); }

log_prob {
  {
    data int a1_1dim__ = (N + 1);
    FnValidateSize__("a1", "N + 1", a1_1dim__);
    vector[a1_1dim__] a1;
    for(n in 1:N) {
      a1[n] = (a1[(n + 1)] + promote(1, real, data));
    }
    target += sum(a1);
  } }

rev_log_prob {
  {
    data int a1_1dim__ = (N + 1);
    FnValidateSize__("a1", "N + 1", a1_1dim__);
    vector[a1_1dim__] a1;
    for(n in 1:N) {
      a1[n] = (a1[(n + 1)] + promote(1, real, data));
    }
    target += sum(a1);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

