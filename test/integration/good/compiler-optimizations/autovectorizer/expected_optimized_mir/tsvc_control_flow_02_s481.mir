/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_control_flow_02_s481.stan : [exit 0] */
input_vars {
  int N;
  vector[N] a0;
  vector[N] b0;
  vector[N] c;
  vector[N] d; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b0", "N", N);
  data vector[N] b0;
  FnReadData__(b0, context__, "b0");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c");
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  FnReadData__(d, context__, "d"); }

log_prob {
  {
    FnValidateSize__("a2", "N", N);
    vector[N] a2;
    a2 = a0;
    for(n in 1:N) {
      if((d[n] < 0)) {
        FnReject__("neg");
      }
      a2[n] = (a2[n] + (b0[n] .* c[n]));
    }
    target += sum(a2);
  } }

rev_log_prob {
  {
    FnValidateSize__("a2", "N", N);
    vector[N] a2;
    a2 = a0;
    for(n in 1:N) {
      if((d[n] < 0)) {
        FnReject__("neg");
      }
      a2[n] = (a2[n] + (b0[n] .* c[n]));
    }
    target += sum(a2);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

