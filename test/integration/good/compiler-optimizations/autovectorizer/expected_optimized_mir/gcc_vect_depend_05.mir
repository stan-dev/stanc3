/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../gcc_vect_depend_05.stan : [exit 0] */
input_vars {
  int N; }

prepare_data {
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1); }

log_prob {
  {
    data int ib5_1dim__ = (N + 1);
    FnValidateSize__("ib5", "N + 1", ib5_1dim__);
    vector[ib5_1dim__] ib5;
    for(n in 1:N) {
      ib5[n] = (ib5[(n + 1)] * promote(4, real, data));
    }
    target += sum(ib5);
  } }

rev_log_prob {
  {
    data int ib5_1dim__ = (N + 1);
    FnValidateSize__("ib5", "N + 1", ib5_1dim__);
    vector[ib5_1dim__] ib5;
    for(n in 1:N) {
      ib5[n] = (ib5[(n + 1)] * promote(4, real, data));
    }
    target += sum(ib5);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

