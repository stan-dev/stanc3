/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../output_dep_backward_gcc_vect_f6.stan : [exit 0] */
input_vars {
  int N;
  vector[N] x;
  vector[N] z; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x");
  FnValidateSize__("z", "N", N);
  data vector[N] z;
  FnReadData__(z, context__, "z"); }

log_prob {
  {
    data int ia4_1dim__ = (N + 1);
    FnValidateSize__("ia4", "N + 1", ia4_1dim__);
    vector[ia4_1dim__] ia4;
    ia4[(1 + 1):(N + 1)] = z[1:N];
    ia4[1:N] = x[1:N];
    target += sum(ia4);
  } }

rev_log_prob {
  {
    data int ia4_1dim__ = (N + 1);
    FnValidateSize__("ia4", "N + 1", ia4_1dim__);
    vector[ia4_1dim__] ia4;
    ia4[(1 + 1):(N + 1)] = z[1:N];
    ia4[1:N] = x[1:N];
    target += sum(ia4);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

