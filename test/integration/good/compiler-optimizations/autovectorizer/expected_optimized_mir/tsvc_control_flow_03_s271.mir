/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_control_flow_03_s271.stan : [exit 0] */
input_vars {
  int N;
  vector[N] a0;
  vector[N] b0;
  vector[N] c; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b0", "N", N);
  data vector[N] b0;
  FnReadData__(b0, context__, "b0");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c"); }

log_prob {
  {
    FnValidateSize__("a3", "N", N);
    vector[N] a3;
    a3 = a0;
    for(n in 1:N) {
      if((b0[n] > 0)) {
        a3[n] = (a3[n] + (b0[n] * c[n]));
      }
    }
    target += sum(a3);
  } }

rev_log_prob {
  {
    FnValidateSize__("a3", "N", N);
    vector[N] a3;
    a3 = a0;
    for(n in 1:N) {
      if((b0[n] > 0)) {
        a3[n] = (a3[n] + (b0[n] * c[n]));
      }
    }
    target += sum(a3);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

