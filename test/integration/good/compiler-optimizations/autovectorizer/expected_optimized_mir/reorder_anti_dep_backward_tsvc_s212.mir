/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../reorder_anti_dep_backward_tsvc_s212.stan : [exit 0] */

input_vars {
  int N;
  vector[(N + 1)] a0;
  vector[(N + 1)] b0;
  vector[N] c;
  vector[N] d; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 3))(var_name N)(var N))__(3);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  FnReadData__(a0, context__, "a0");
  data int b0_1dim__ = (N + 1);
  FnValidateSize__("b0", "N + 1", b0_1dim__);
  data vector[b0_1dim__] b0;
  FnReadData__(b0, context__, "b0");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c");
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  FnReadData__(d, context__, "d"); }

log_prob {
  {
    data int a2_1dim__ = (N + 1);
    FnValidateSize__("a2", "N + 1", a2_1dim__);
    vector[a2_1dim__] a2;
    a2 = a0;
    data int b2_1dim__ = (N + 1);
    FnValidateSize__("b2", "N + 1", b2_1dim__);
    vector[b2_1dim__] b2;
    b2 = b0;
    for(n in 1:N) {
      a2[n] = (a2[n] .* c[n]);
      b2[n] = (b2[n] + (a2[(n + 1)] .* d[n]));
    }
    target += sum(a2);
    target += sum(b2);
  } }

rev_log_prob {
  {
    data int a2_1dim__ = (N + 1);
    FnValidateSize__("a2", "N + 1", a2_1dim__);
    vector[a2_1dim__] a2;
    a2 = a0;
    data int b2_1dim__ = (N + 1);
    FnValidateSize__("b2", "N + 1", b2_1dim__);
    vector[b2_1dim__] b2;
    b2 = b0;
    for(n in 1:N) {
      a2[n] = (a2[n] .* c[n]);
      b2[n] = (b2[n] + (a2[(n + 1)] .* d[n]));
    }
    target += sum(a2);
    target += sum(b2);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

