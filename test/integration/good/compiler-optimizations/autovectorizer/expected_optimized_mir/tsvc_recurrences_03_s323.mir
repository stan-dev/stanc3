/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_recurrences_03_s323.stan : [exit 0] */

input_vars {
  int N;
  vector[N] a0;
  vector[N] b;
  vector[N] c;
  vector[N] d;
  vector[N] e; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 3))(var_name N)(var N))__(3);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c");
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  FnReadData__(d, context__, "d");
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  FnReadData__(e, context__, "e"); }

log_prob {
  {
    FnValidateSize__("a3", "N", N);
    vector[N] a3;
    a3 = a0;
    FnValidateSize__("b3", "N", N);
    vector[N] b3;
    b3 = b;
    for(n in 2:N) {
      a3[n] = (b3[(n - 1)] + (c[n] * d[n]));
      b3[n] = (a3[n] + (c[n] * e[n]));
    }
    target += (sum(a3) + sum(b3));
  } }

rev_log_prob {
  {
    FnValidateSize__("a3", "N", N);
    vector[N] a3;
    a3 = a0;
    FnValidateSize__("b3", "N", N);
    vector[N] b3;
    b3 = b;
    for(n in 2:N) {
      a3[n] = (b3[(n - 1)] + (c[n] * d[n]));
      b3[n] = (a3[n] + (c[n] * e[n]));
    }
    target += (sum(a3) + sum(b3));
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

