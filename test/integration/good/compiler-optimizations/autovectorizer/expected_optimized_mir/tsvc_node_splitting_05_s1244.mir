/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_node_splitting_05_s1244.stan : [exit 0] */
input_vars {
  int N;
  vector[(N + 1)] a0;
  vector[N] b0;
  vector[N] d0;
  vector[N] c; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b0", "N", N);
  data vector[N] b0;
  FnReadData__(b0, context__, "b0");
  FnValidateSize__("d0", "N", N);
  data vector[N] d0;
  FnReadData__(d0, context__, "d0");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c"); }

log_prob {
  {
    data int a5_1dim__ = (N + 1);
    FnValidateSize__("a5", "N + 1", a5_1dim__);
    vector[a5_1dim__] a5;
    a5 = a0;
    FnValidateSize__("b5", "N", N);
    vector[N] b5;
    b5 = b0;
    FnValidateSize__("d5", "N", N);
    vector[N] d5;
    d5 = d0;
    for(n in 1:N) {
      a5[n] = (b5[n] + (c[n] .* c[n]));
      d5[n] = (a5[n] + a5[(n + 1)]);
    }
    target += sum(a5);
    target += sum(d5);
  } }

rev_log_prob {
  {
    data int a5_1dim__ = (N + 1);
    FnValidateSize__("a5", "N + 1", a5_1dim__);
    vector[a5_1dim__] a5;
    a5 = a0;
    FnValidateSize__("b5", "N", N);
    vector[N] b5;
    b5 = b0;
    FnValidateSize__("d5", "N", N);
    vector[N] d5;
    d5 = d0;
    for(n in 1:N) {
      a5[n] = (b5[n] + (c[n] .* c[n]));
      d5[n] = (a5[n] + a5[(n + 1)]);
    }
    target += sum(a5);
    target += sum(d5);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

