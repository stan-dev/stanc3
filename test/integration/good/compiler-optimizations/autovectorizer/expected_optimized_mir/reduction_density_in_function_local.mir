/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../reduction_density_in_function_local.stan : [exit 0] */
functions {
  real normal_loop1_lpdf(vector y, vector mu, real sigma) {
    {
      real lp1;
      lp1 = promote(0, real, var);
      for(n in 1:num_elements(y)) {
        lp1 = (lp1 + normal_lpdf(y[n], mu[n], sigma));
      }
      return lp1;
    }
  } }
input_vars {
  int N;
  vector[N] x;
  vector[N] y; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x");
  FnValidateSize__("y", "N", N);
  data vector[N] y;
  FnReadData__(y, context__, "y"); }

log_prob {
  real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  real beta = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("mu1", "N", N);
    vector[N] mu1;
    mu1 = (alpha + (beta * x));
    target += normal_loop1_lpdf(y, mu1, sigma);
  } }

rev_log_prob {
  real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  real beta = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    FnValidateSize__("mu1", "N", N);
    vector[N] mu1;
    mu1 = (alpha + (beta * x));
    target += normal_loop1_lpdf(y, mu1, sigma);
  } }

generate_quantities {
  data real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  data real
    beta = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  data real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var alpha))__();
  (FnWriteParam(unconstrain_opt())(var beta))__();
  (FnWriteParam(unconstrain_opt())(var sigma))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real alpha;
  FnReadData__(alpha, context__, "alpha");
  (FnWriteParam(unconstrain_opt(Identity))(var alpha))__();
  real beta;
  FnReadData__(beta, context__, "beta");
  (FnWriteParam(unconstrain_opt(Identity))(var beta))__();
  real sigma;
  FnReadData__(sigma, context__, "sigma");
  (FnWriteParam(unconstrain_opt((Lower 0)))(var sigma))__(); }

output_vars {
  parameters real alpha; //real
  parameters real beta; //real
  parameters real sigma; //real
}
