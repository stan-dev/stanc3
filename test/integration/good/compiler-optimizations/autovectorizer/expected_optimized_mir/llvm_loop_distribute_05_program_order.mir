/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../llvm_loop_distribute_05_program_order.stan : [exit 0] */
input_vars {
  int N;
  vector[N] b;
  vector[N] e;
  vector[N] D; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b");
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  FnReadData__(e, context__, "e");
  FnValidateSize__("D", "N", N);
  data vector[N] D;
  FnReadData__(D, context__, "D"); }

log_prob {
  {
    data int a5_1dim__ = (N + 1);
    FnValidateSize__("a5", "N + 1", a5_1dim__);
    vector[a5_1dim__] a5;
    FnValidateSize__("c5", "N", N);
    vector[N] c5;
    for(n in 1:N) {
      real dd5;
      dd5 = D[n];
      a5[(n + 1)] = (a5[n] * b[n]);
      c5[n] = (dd5 * e[n]);
    }
    target += (sum(a5) + sum(c5));
  } }

rev_log_prob {
  {
    data int a5_1dim__ = (N + 1);
    FnValidateSize__("a5", "N + 1", a5_1dim__);
    vector[a5_1dim__] a5;
    FnValidateSize__("c5", "N", N);
    vector[N] c5;
    for(n in 1:N) {
      real dd5;
      dd5 = D[n];
      a5[(n + 1)] = (a5[n] * b[n]);
      c5[n] = (dd5 * e[n]);
    }
    target += (sum(a5) + sum(c5));
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

