/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../gather_on_written_var.stan : [exit 0] */
input_vars {
  int N;
  array[int, N] idx;
  vector[N] x;
  vector[N] v0; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  FnValidateSize__("idx", "N", N);
  data array[int, N] idx;
  FnReadData__(idx, context__, "idx");
  (FnCheck(trans(Lower 1))(var_name idx)(var idx))__(1);
  (FnCheck(trans(Upper N))(var_name idx)(var idx))__(N);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x");
  FnValidateSize__("v0", "N", N);
  data vector[N] v0;
  FnReadData__(v0, context__, "v0"); }

log_prob {
  {
    FnValidateSize__("v9b", "N", N);
    vector[N] v9b;
    v9b = v0;
    FnValidateSize__("y9b", "N", N);
    vector[N] y9b;
    for(n in 1:N) {
      v9b[idx[n]] = x[n];
      y9b[n] = v9b[idx[n]];
    }
    target += (sum(v9b) + sum(y9b));
  } }

rev_log_prob {
  {
    FnValidateSize__("v9b", "N", N);
    vector[N] v9b;
    v9b = v0;
    FnValidateSize__("y9b", "N", N);
    vector[N] y9b;
    for(n in 1:N) {
      v9b[idx[n]] = x[n];
      y9b[n] = v9b[idx[n]];
    }
    target += (sum(v9b) + sum(y9b));
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

