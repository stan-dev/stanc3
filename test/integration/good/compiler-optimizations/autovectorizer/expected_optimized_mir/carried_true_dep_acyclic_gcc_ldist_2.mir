/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../carried_true_dep_acyclic_gcc_ldist_2.stan : [exit 0] */
input_vars {
  int N;
  vector[N] c; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c"); }

log_prob {
  {
    FnValidateSize__("a2", "N", N);
    vector[N] a2;
    FnValidateSize__("b2", "N", N);
    vector[N] b2;
    for(n in 2:N) {
      a2[n] = (a2[n] + c[n]);
      b2[n] = (a2[(n - 1)] + promote(1, real, data));
    }
    target += (sum(a2) + sum(b2));
  } }

rev_log_prob {
  {
    FnValidateSize__("a2", "N", N);
    vector[N] a2;
    FnValidateSize__("b2", "N", N);
    vector[N] b2;
    for(n in 2:N) {
      a2[n] = (a2[n] + c[n]);
      b2[n] = (a2[(n - 1)] + promote(1, real, data));
    }
    target += (sum(a2) + sum(b2));
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

