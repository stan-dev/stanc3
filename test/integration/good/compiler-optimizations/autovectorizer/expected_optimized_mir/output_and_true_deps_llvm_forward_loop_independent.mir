/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../output_and_true_deps_llvm_forward_loop_independent.stan : [exit 0] */
input_vars {
  int N;
  vector[N] b; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b"); }

log_prob {
  {
    data int a2_1dim__ = (N + 1);
    FnValidateSize__("a2", "N + 1", a2_1dim__);
    vector[a2_1dim__] a2;
    FnValidateSize__("c2", "N", N);
    vector[N] c2;
    a2[(1 + 1):(N + 1)] = (b[1:N] + promote(1, real, data));
    a2[1:N] = (b[1:N] + promote(2, real, data));
    c2[1:N] = (a2[1:N] * promote(2, real, data));
    target += (sum(a2) + sum(c2));
  } }

rev_log_prob {
  {
    data int a2_1dim__ = (N + 1);
    FnValidateSize__("a2", "N + 1", a2_1dim__);
    vector[a2_1dim__] a2;
    FnValidateSize__("c2", "N", N);
    vector[N] c2;
    a2[(1 + 1):(N + 1)] = (b[1:N] + promote(1, real, data));
    a2[1:N] = (b[1:N] + promote(2, real, data));
    c2[1:N] = (a2[1:N] * promote(2, real, data));
    target += (sum(a2) + sum(c2));
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

