/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../design_examples_03.stan : [exit 0] */
input_vars {
  int N;
  vector[N] x; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x"); }

log_prob {
  {
    FnValidateSize__("mu3", "N", N);
    vector[N] mu3;
    for(n in 1:N) {
      mu3[n] = (promote(2, real, data) * x[n]);
      FnPrint__(mu3[n]);
    }
    target += sum(mu3);
  } }

rev_log_prob {
  {
    FnValidateSize__("mu3", "N", N);
    vector[N] mu3;
    for(n in 1:N) {
      mu3[n] = (promote(2, real, data) * x[n]);
      FnPrint__(mu3[n]);
    }
    target += sum(mu3);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

