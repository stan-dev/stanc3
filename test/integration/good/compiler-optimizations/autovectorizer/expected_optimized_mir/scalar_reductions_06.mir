/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../scalar_reductions_06.stan : [exit 0] */
input_vars {
  int N;
  vector[N] x;
  vector[N] w; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x");
  FnValidateSize__("w", "N", N);
  data vector[N] w;
  FnReadData__(w, context__, "w");
  (FnCheck(trans(Lower 0))(var_name w)(var w))__(0); }

log_prob {
  real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  real beta = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  {
    FnValidateSize__("mu6", "N", N);
    vector[N] mu6;
    real s6;
    s6 = promote(0, real, var);
    for(n in 1:N) {
      mu6[n] = (alpha + (beta * x[n]));
      s6 = (s6 + mu6[n]);
      s6 = (s6 + w[n]);
    }
    target += s6;
  } }

rev_log_prob {
  real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  real beta = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  {
    FnValidateSize__("mu6", "N", N);
    vector[N] mu6;
    real s6;
    s6 = promote(0, real, var);
    for(n in 1:N) {
      mu6[n] = (alpha + (beta * x[n]));
      s6 = (s6 + mu6[n]);
      s6 = (s6 + w[n]);
    }
    target += s6;
  } }

generate_quantities {
  data real
    alpha = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  data real
    beta = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var alpha))__();
  (FnWriteParam(unconstrain_opt())(var beta))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real alpha;
  FnReadData__(alpha, context__, "alpha");
  (FnWriteParam(unconstrain_opt(Identity))(var alpha))__();
  real beta;
  FnReadData__(beta, context__, "beta");
  (FnWriteParam(unconstrain_opt(Identity))(var beta))__(); }
output_vars {
  parameters real alpha; //real
  parameters real beta; //real
}
