/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../llvm_loop_access_04_store_to_invariant_check1.stan : [exit 0] */
input_vars {
  int N;
  int J;
  vector[J] w; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  data int J;
  FnReadData__(J, context__, "J");
  (FnCheck(trans(Lower 1))(var_name J)(var J))__(1);
  FnValidateSize__("w", "J", J);
  data vector[J] w;
  FnReadData__(w, context__, "w"); }

log_prob {
  {
    FnValidateSize__("v4", "N", N);
    vector[N] v4;
    for(i in 1:N) {
      for(j in 1:J) {
        v4[i] = (w[j] + v4[i]);
      }
    }
    target += sum(v4);
  } }

rev_log_prob {
  {
    FnValidateSize__("v4", "N", N);
    vector[N] v4;
    for(i in 1:N) {
      for(j in 1:J) {
        v4[i] = (w[j] + v4[i]);
      }
    }
    target += sum(v4);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

