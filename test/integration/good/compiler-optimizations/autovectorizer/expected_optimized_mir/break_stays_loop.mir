/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../break_stays_loop.stan : [exit 0] */
input_vars {
  int N;
  vector[N] x; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 0))(var_name N)(var N))__(0);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x"); }

log_prob {
  {
    for(k in 1:N) {
      target += std_normal_lupdf(x[k]);
      if((x[k] < 0)) {
        break;
      }
    }
  } }

rev_log_prob {
  {
    for(k in 1:N) {
      target += std_normal_lupdf(x[k]);
      if((x[k] < 0)) {
        break;
      }
    }
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

