/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_indirect_addressing_02_s4113.stan : [exit 0] */
input_vars {
  int N;
  array[int, N] ip;
  vector[N] a0;
  vector[N] b;
  vector[N] c; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("ip", "N", N);
  data array[int, N] ip;
  FnReadData__(ip, context__, "ip");
  (FnCheck(trans(Lower 1))(var_name ip)(var ip))__(1);
  (FnCheck(trans(Upper N))(var_name ip)(var ip))__(N);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c"); }

log_prob {
  {
    FnValidateSize__("a2", "N", N);
    vector[N] a2;
    a2 = a0;
    a2[ip[1:N]] = (b[ip[1:N]] + c[1:N]);
    target += sum(a2);
  } }

rev_log_prob {
  {
    FnValidateSize__("a2", "N", N);
    vector[N] a2;
    a2 = a0;
    a2[ip[1:N]] = (b[ip[1:N]] + c[1:N]);
    target += sum(a2);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

