/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../gcc_vect_depend_02_f2.stan : [exit 0] */
input_vars {
  int N;
  vector[N] x; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x"); }

log_prob {
  {
    data int ia2_1dim__ = (N + 1);
    FnValidateSize__("ia2", "N + 1", ia2_1dim__);
    vector[ia2_1dim__] ia2;
    data int ib2_1dim__ = (N + 1);
    FnValidateSize__("ib2", "N + 1", ib2_1dim__);
    vector[ib2_1dim__] ib2;
    for(n in 1:N) {
      ia2[n] = x[n];
      ib2[n] = ia2[(n + 1)];
    }
    target += (sum(ia2) + sum(ib2));
  } }

rev_log_prob {
  {
    data int ia2_1dim__ = (N + 1);
    FnValidateSize__("ia2", "N + 1", ia2_1dim__);
    vector[ia2_1dim__] ia2;
    data int ib2_1dim__ = (N + 1);
    FnValidateSize__("ib2", "N + 1", ib2_1dim__);
    vector[ib2_1dim__] ib2;
    for(n in 1:N) {
      ia2[n] = x[n];
      ib2[n] = ia2[(n + 1)];
    }
    target += (sum(ia2) + sum(ib2));
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

