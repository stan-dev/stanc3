/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_linear_dependence_01_s112.stan : [exit 0] */
input_vars {
  int N;
  vector[(N + 1)] a0;
  vector[N] b; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b"); }

log_prob {
  {
    data int a1_1dim__ = (N + 1);
    FnValidateSize__("a1", "N + 1", a1_1dim__);
    vector[a1_1dim__] a1;
    a1 = a0;
    for(n in 1:N) {
      a1[(n + 1)] = (a1[n] + b[n]);
    }
    target += sum(a1);
  } }

rev_log_prob {
  {
    data int a1_1dim__ = (N + 1);
    FnValidateSize__("a1", "N + 1", a1_1dim__);
    vector[a1_1dim__] a1;
    a1 = a0;
    for(n in 1:N) {
      a1[(n + 1)] = (a1[n] + b[n]);
    }
    target += sum(a1);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

