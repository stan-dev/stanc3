/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_statement_reordering_01_s211.stan : [exit 0] */

input_vars {
  int N;
  vector[(N + 1)] a0;
  vector[(N + 1)] b0;
  vector[N] c;
  vector[N] d;
  vector[N] e; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 3))(var_name N)(var N))__(3);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  FnReadData__(a0, context__, "a0");
  data int b0_1dim__ = (N + 1);
  FnValidateSize__("b0", "N + 1", b0_1dim__);
  data vector[b0_1dim__] b0;
  FnReadData__(b0, context__, "b0");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c");
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  FnReadData__(d, context__, "d");
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  FnReadData__(e, context__, "e"); }

log_prob {
  {
    data int a1_1dim__ = (N + 1);
    FnValidateSize__("a1", "N + 1", a1_1dim__);
    vector[a1_1dim__] a1;
    a1 = a0;
    data int b1_1dim__ = (N + 1);
    FnValidateSize__("b1", "N + 1", b1_1dim__);
    vector[b1_1dim__] b1;
    b1 = b0;
    for(n in 2:(N - 1)) {
      a1[n] = (b1[(n - 1)] + (c[n] .* d[n]));
      b1[n] = (b1[(n + 1)] - (e[n] .* d[n]));
    }
    target += sum(a1);
    target += sum(b1);
  } }

rev_log_prob {
  {
    data int a1_1dim__ = (N + 1);
    FnValidateSize__("a1", "N + 1", a1_1dim__);
    vector[a1_1dim__] a1;
    a1 = a0;
    data int b1_1dim__ = (N + 1);
    FnValidateSize__("b1", "N + 1", b1_1dim__);
    vector[b1_1dim__] b1;
    b1 = b0;
    for(n in 2:(N - 1)) {
      a1[n] = (b1[(n - 1)] + (c[n] .* d[n]));
      b1[n] = (b1[(n + 1)] - (e[n] .* d[n]));
    }
    target += sum(a1);
    target += sum(b1);
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

