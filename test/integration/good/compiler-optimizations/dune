(subdir
 dunes
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    O0.inc
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "--print-cpp --O0"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    O1.inc
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "--print-cpp --O1"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    Oexperimental.inc
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "--print-cpp --Oexperimental"
     %{stanfiles})))))

(subdir
 expected_O0
 (dynamic_include ../dunes/O0.inc))

(subdir
 expected_O1
 (dynamic_include ../dunes/O1.inc))

(subdir
 expected_experimental
 (dynamic_include ../dunes/Oexperimental.inc))
