(rule
 (targets experimental.inc.gen)
 (deps
  (:stanfiles
   (glob_files *.stan)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/gen_expected_rules.exe
    experimental
    cpp
    "--Oexperimental --print-cpp"
    %{stanfiles}))))

(rule
 (alias update-rules)
 (action
  (diff expected_experimental/dune.inc experimental.inc.gen)))

(include expected_experimental/dune.inc)

