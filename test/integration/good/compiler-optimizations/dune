(subdir
 dunes
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    O0.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "--print-cpp --O0"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    O1.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "--print-cpp --O1"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    Oexperimental.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "--print-cpp --Oexperimental"
     %{stanfiles})))))

(subdir
 expected_O0
 (dynamic_include ../dunes/O0.dune))

(subdir
 expected_O1
 (dynamic_include ../dunes/O1.dune))

(subdir
 expected_experimental
 (dynamic_include ../dunes/Oexperimental.dune))
