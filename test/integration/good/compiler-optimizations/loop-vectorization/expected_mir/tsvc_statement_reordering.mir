/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_statement_reordering.stan : [exit 0] */

input_vars {
  int N;
  vector[(N + 1)] a0;
  vector[(N + 1)] b0;
  vector[N] c;
  vector[N] d;
  vector[N] e; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 3))(var_name N)(var N))__(3);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  FnReadData__(a0, context__, "a0");
  data int b0_1dim__ = (N + 1);
  FnValidateSize__("b0", "N + 1", b0_1dim__);
  data vector[b0_1dim__] b0;
  FnReadData__(b0, context__, "b0");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c");
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  FnReadData__(d, context__, "d");
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  FnReadData__(e, context__, "e"); }

log_prob {
  {
    {
      data int a1_1dim__ = (N + 1);
      FnValidateSize__("a1", "N + 1", a1_1dim__);
      vector[a1_1dim__] a1;
      a1 = a0;
      data int b1_1dim__ = (N + 1);
      FnValidateSize__("b1", "N + 1", b1_1dim__);
      vector[b1_1dim__] b1;
      b1 = b0;
      b1[2:(N - 1)] = (b1[(2 + 1):((N - 1) + 1)] - (e[2:(N - 1)] .* d
                                                                    [2:(N - 1)]));
      a1[2:(N - 1)] = (b1[(2 - 1):((N - 1) - 1)] + (c[2:(N - 1)] .* d
                                                                    [2:(N - 1)]));
      target += sum(a1);
      target += sum(b1);
    }
    {
      data int a2_1dim__ = (N + 1);
      FnValidateSize__("a2", "N + 1", a2_1dim__);
      vector[a2_1dim__] a2;
      a2 = a0;
      data int b2_1dim__ = (N + 1);
      FnValidateSize__("b2", "N + 1", b2_1dim__);
      vector[b2_1dim__] b2;
      b2 = b0;
      b2[1:N] = (b2[1:N] + (a2[(1 + 1):(N + 1)] .* d[1:N]));
      a2[1:N] = (a2[1:N] .* c[1:N]);
      target += sum(a2);
      target += sum(b2);
    }
  } }

rev_log_prob {
  {
    {
      data int a1_1dim__ = (N + 1);
      FnValidateSize__("a1", "N + 1", a1_1dim__);
      vector[a1_1dim__] a1;
      a1 = a0;
      data int b1_1dim__ = (N + 1);
      FnValidateSize__("b1", "N + 1", b1_1dim__);
      vector[b1_1dim__] b1;
      b1 = b0;
      b1[2:(N - 1)] = (b1[(2 + 1):((N - 1) + 1)] - (e[2:(N - 1)] .* d
                                                                    [2:(N - 1)]));
      a1[2:(N - 1)] = (b1[(2 - 1):((N - 1) - 1)] + (c[2:(N - 1)] .* d
                                                                    [2:(N - 1)]));
      target += sum(a1);
      target += sum(b1);
    }
    {
      data int a2_1dim__ = (N + 1);
      FnValidateSize__("a2", "N + 1", a2_1dim__);
      vector[a2_1dim__] a2;
      a2 = a0;
      data int b2_1dim__ = (N + 1);
      FnValidateSize__("b2", "N + 1", b2_1dim__);
      vector[b2_1dim__] b2;
      b2 = b0;
      b2[1:N] = (b2[1:N] + (a2[(1 + 1):(N + 1)] .* d[1:N]));
      a2[1:N] = (a2[1:N] .* c[1:N]);
      target += sum(a2);
      target += sum(b2);
    }
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

