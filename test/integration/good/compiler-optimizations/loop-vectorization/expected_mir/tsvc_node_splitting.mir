/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_node_splitting.stan : [exit 0] */

input_vars {
  int N;
  vector[(N + 1)] a0;
  vector[N] b0;
  vector[N] d0;
  vector[N] c;
  vector[N] e; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b0", "N", N);
  data vector[N] b0;
  FnReadData__(b0, context__, "b0");
  FnValidateSize__("d0", "N", N);
  data vector[N] d0;
  FnReadData__(d0, context__, "d0");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c");
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  FnReadData__(e, context__, "e"); }

log_prob {
  {
    {
      data int a1_1dim__ = (N + 1);
      FnValidateSize__("a1", "N + 1", a1_1dim__);
      vector[a1_1dim__] a1;
      a1 = a0;
      FnValidateSize__("b1", "N", N);
      vector[N] b1;
      b1 = b0;
      a1[(1 + 1):(N + 1)] = (b1[1:N] + e[1:N]);
      a1[1:N] = (b1[1:N] + c[1:N]);
      target += sum(a1);
    }
    {
      data int a2_1dim__ = (N + 1);
      FnValidateSize__("a2", "N + 1", a2_1dim__);
      vector[a2_1dim__] a2;
      a2 = a0;
      FnValidateSize__("b2", "N", N);
      vector[N] b2;
      b2 = b0;
      FnValidateSize__("d2", "N", N);
      vector[N] d2;
      d2 = d0;
      for(n in 1:N) {
        a2[n] = ((b2[n] .* c[n]) .* d2[n]);
        b2[n] = ((a2[n] .* a2[(n + 1)]) .* d2[n]);
      }
      target += sum(a2);
      target += sum(b2);
    }
    {
      data int a3_1dim__ = (N + 1);
      FnValidateSize__("a3", "N + 1", a3_1dim__);
      vector[a3_1dim__] a3;
      a3 = a0;
      FnValidateSize__("b3", "N", N);
      vector[N] b3;
      b3 = b0;
      FnValidateSize__("d3", "N", N);
      vector[N] d3;
      d3 = d0;
      for(n in 1:N) {
        a3[n] = (b3[n] + (c[n] .* d3[n]));
        b3[n] = (a3[n] + (d3[n] .* e[n]));
        a3[n] = (b3[n] + (a3[(n + 1)] .* d3[n]));
      }
      target += sum(a3);
      target += sum(b3);
    }
    {
      data int a4_1dim__ = (N + 1);
      FnValidateSize__("a4", "N + 1", a4_1dim__);
      vector[a4_1dim__] a4;
      a4 = a0;
      FnValidateSize__("b4", "N", N);
      vector[N] b4;
      b4 = b0;
      FnValidateSize__("d4", "N", N);
      vector[N] d4;
      d4 = d0;
      for(n in 1:N) {
        a4[n] = (b4[n] + (c[n] .* d4[n]));
        b4[n] = (c[n] + b4[n]);
        a4[(n + 1)] = (b4[n] + (a4[(n + 1)] .* d4[n]));
      }
      target += sum(a4);
      target += sum(b4);
    }
    {
      data int a5_1dim__ = (N + 1);
      FnValidateSize__("a5", "N + 1", a5_1dim__);
      vector[a5_1dim__] a5;
      a5 = a0;
      FnValidateSize__("b5", "N", N);
      vector[N] b5;
      b5 = b0;
      FnValidateSize__("d5", "N", N);
      vector[N] d5;
      d5 = d0;
      for(n in 1:N) {
        a5[n] = (b5[n] + (c[n] .* c[n]));
        d5[n] = (a5[n] + a5[(n + 1)]);
      }
      target += sum(a5);
      target += sum(d5);
    }
  } }

rev_log_prob {
  {
    {
      data int a1_1dim__ = (N + 1);
      FnValidateSize__("a1", "N + 1", a1_1dim__);
      vector[a1_1dim__] a1;
      a1 = a0;
      FnValidateSize__("b1", "N", N);
      vector[N] b1;
      b1 = b0;
      a1[(1 + 1):(N + 1)] = (b1[1:N] + e[1:N]);
      a1[1:N] = (b1[1:N] + c[1:N]);
      target += sum(a1);
    }
    {
      data int a2_1dim__ = (N + 1);
      FnValidateSize__("a2", "N + 1", a2_1dim__);
      vector[a2_1dim__] a2;
      a2 = a0;
      FnValidateSize__("b2", "N", N);
      vector[N] b2;
      b2 = b0;
      FnValidateSize__("d2", "N", N);
      vector[N] d2;
      d2 = d0;
      for(n in 1:N) {
        a2[n] = ((b2[n] .* c[n]) .* d2[n]);
        b2[n] = ((a2[n] .* a2[(n + 1)]) .* d2[n]);
      }
      target += sum(a2);
      target += sum(b2);
    }
    {
      data int a3_1dim__ = (N + 1);
      FnValidateSize__("a3", "N + 1", a3_1dim__);
      vector[a3_1dim__] a3;
      a3 = a0;
      FnValidateSize__("b3", "N", N);
      vector[N] b3;
      b3 = b0;
      FnValidateSize__("d3", "N", N);
      vector[N] d3;
      d3 = d0;
      for(n in 1:N) {
        a3[n] = (b3[n] + (c[n] .* d3[n]));
        b3[n] = (a3[n] + (d3[n] .* e[n]));
        a3[n] = (b3[n] + (a3[(n + 1)] .* d3[n]));
      }
      target += sum(a3);
      target += sum(b3);
    }
    {
      data int a4_1dim__ = (N + 1);
      FnValidateSize__("a4", "N + 1", a4_1dim__);
      vector[a4_1dim__] a4;
      a4 = a0;
      FnValidateSize__("b4", "N", N);
      vector[N] b4;
      b4 = b0;
      FnValidateSize__("d4", "N", N);
      vector[N] d4;
      d4 = d0;
      for(n in 1:N) {
        a4[n] = (b4[n] + (c[n] .* d4[n]));
        b4[n] = (c[n] + b4[n]);
        a4[(n + 1)] = (b4[n] + (a4[(n + 1)] .* d4[n]));
      }
      target += sum(a4);
      target += sum(b4);
    }
    {
      data int a5_1dim__ = (N + 1);
      FnValidateSize__("a5", "N + 1", a5_1dim__);
      vector[a5_1dim__] a5;
      a5 = a0;
      FnValidateSize__("b5", "N", N);
      vector[N] b5;
      b5 = b0;
      FnValidateSize__("d5", "N", N);
      vector[N] d5;
      d5 = d0;
      for(n in 1:N) {
        a5[n] = (b5[n] + (c[n] .* c[n]));
        d5[n] = (a5[n] + a5[(n + 1)]);
      }
      target += sum(a5);
      target += sum(d5);
    }
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

