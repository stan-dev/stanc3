/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../tsvc_indirect_addressing.stan : [exit 0] */

input_vars {
  int N;
  array[int, N] ip;
  vector[N] a0;
  vector[N] b;
  vector[N] c;
  vector[N] d;
  real s;
  vector[N] a_data; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("ip", "N", N);
  data array[int, N] ip;
  FnReadData__(ip, context__, "ip");
  (FnCheck(trans(Lower 1))(var_name ip)(var ip))__(1);
  (FnCheck(trans(Upper N))(var_name ip)(var ip))__(N);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b");
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  FnReadData__(c, context__, "c");
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  FnReadData__(d, context__, "d");
  data real s;
  FnReadData__(s, context__, "s");
  FnValidateSize__("a_data", "N", N);
  data vector[N] a_data;
  FnReadData__(a_data, context__, "a_data"); }

log_prob {
  real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    {
      FnValidateSize__("a1", "N", N);
      vector[N] a1;
      a1 = a0;
      a1[1:N] = (a1[1:N] + (b[ip[1:N]] * s));
      target += sum(a1);
    }
    {
      FnValidateSize__("a2", "N", N);
      vector[N] a2;
      a2 = a0;
      a2[ip[1:N]] = (b[ip[1:N]] + c[1:N]);
      target += sum(a2);
    }
    {
      target += normal_lpdf(a_data[1:N], b[ip[1:N]], sigma);
    }
    {
      FnValidateSize__("a4", "N", N);
      vector[N] a4;
      a4 = a0;
      a4[ip[1:N]] = (b[1:N] + (c[1:N] .* d[1:N]));
      target += sum(a4);
    }
  } }

rev_log_prob {
  real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    {
      FnValidateSize__("a1", "N", N);
      vector[N] a1;
      a1 = a0;
      a1[1:N] = (a1[1:N] + (b[ip[1:N]] * s));
      target += sum(a1);
    }
    {
      FnValidateSize__("a2", "N", N);
      vector[N] a2;
      a2 = a0;
      a2[ip[1:N]] = (b[ip[1:N]] + c[1:N]);
      target += sum(a2);
    }
    {
      target += normal_lpdf(a_data[1:N], b[ip[1:N]], sigma);
    }
    {
      FnValidateSize__("a4", "N", N);
      vector[N] a4;
      a4 = a0;
      a4[ip[1:N]] = (b[1:N] + (c[1:N] .* d[1:N]));
      target += sum(a4);
    }
  } }

generate_quantities {
  data real
    sigma = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var sigma))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real sigma;
  FnReadData__(sigma, context__, "sigma");
  (FnWriteParam(unconstrain_opt((Lower 0)))(var sigma))__(); }
output_vars {
  parameters real sigma; //real
}
