/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../llvm_loop_distribute.stan : [exit 0] */

input_vars {
  int N;
  int J;
  vector[N] b;
  vector[N] d;
  vector[N] e;
  vector[N] D;
  matrix[N, J] mb;
  matrix[N, J] mc;
  matrix[N, J] me;
  matrix[N, J] mf; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  data int J;
  FnReadData__(J, context__, "J");
  (FnCheck(trans(Lower 1))(var_name J)(var J))__(1);
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  FnReadData__(b, context__, "b");
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  FnReadData__(d, context__, "d");
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  FnReadData__(e, context__, "e");
  FnValidateSize__("D", "N", N);
  data vector[N] D;
  FnReadData__(D, context__, "D");
  FnValidateSize__("mb", "N", N);
  FnValidateSize__("mb", "J", J);
  data matrix[N, J] mb;
  FnReadData__(mb, context__, "mb");
  FnValidateSize__("mc", "N", N);
  FnValidateSize__("mc", "J", J);
  data matrix[N, J] mc;
  FnReadData__(mc, context__, "mc");
  FnValidateSize__("me", "N", N);
  FnValidateSize__("me", "J", J);
  data matrix[N, J] me;
  FnReadData__(me, context__, "me");
  FnValidateSize__("mf", "N", N);
  FnValidateSize__("mf", "J", J);
  data matrix[N, J] mf;
  FnReadData__(mf, context__, "mf"); }

log_prob {
  real mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  {
    {
      FnValidateSize__("a1", "N", N);
      vector[N] a1;
      a1[1:N] = (b[1:N] .* d[1:N]);
      target += sum(a1);
    }
    {
      data int a2_1dim__ = (N + 1);
      FnValidateSize__("a2", "N + 1", a2_1dim__);
      vector[a2_1dim__] a2;
      FnValidateSize__("c2", "N", N);
      vector[N] c2;
      for(n in 1:N) a2[(n + 1)] = (a2[n] * b[n]);
      c2[1:N] = (d[1:N] .* e[1:N]);
      target += (sum(a2) + sum(c2));
    }
    {
      FnValidateSize__("ma3", "N", N);
      data int ma3_2dim__ = (J + 1);
      FnValidateSize__("ma3", "J + 1", ma3_2dim__);
      matrix[N, ma3_2dim__] ma3;
      FnValidateSize__("md3", "N", N);
      FnValidateSize__("md3", "J", J);
      matrix[N, J] md3;
      for(i in 1:N) {
        for(j in 1:J) ma3[i, (j + 1)] = ((ma3[i, j] + mb[i, j]) + mc[i, j]);
        md3[i, 1:J] = (me[i, 1:J] .* mf[i, 1:J]);
      }
      target += (sum(ma3) + sum(md3));
    }
    {
      data int a4_1dim__ = (N + 1);
      FnValidateSize__("a4", "N + 1", a4_1dim__);
      vector[a4_1dim__] a4;
      real total4;
      total4 = promote(0, real, var);
      for(n in 1:N) {
        a4[(n + 1)] = (a4[n] * b[n]);
        total4 = (total4 + d[n]);
      }
      target += (sum(a4) + total4);
    }
    {
      data int a5_1dim__ = (N + 1);
      FnValidateSize__("a5", "N + 1", a5_1dim__);
      vector[a5_1dim__] a5;
      FnValidateSize__("c5", "N", N);
      vector[N] c5;
      for(n in 1:N) {
        real dd5;
        dd5 = D[n];
        a5[(n + 1)] = (a5[n] * b[n]);
        c5[n] = (dd5 * e[n]);
      }
      target += (sum(a5) + sum(c5));
    }
    target += normal_lupdf(mu, promote(0, real, data), promote(1, real, data));
  } }

rev_log_prob {
  real mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  {
    {
      FnValidateSize__("a1", "N", N);
      vector[N] a1;
      a1[1:N] = (b[1:N] .* d[1:N]);
      target += sum(a1);
    }
    {
      data int a2_1dim__ = (N + 1);
      FnValidateSize__("a2", "N + 1", a2_1dim__);
      vector[a2_1dim__] a2;
      FnValidateSize__("c2", "N", N);
      vector[N] c2;
      for(n in 1:N) a2[(n + 1)] = (a2[n] * b[n]);
      c2[1:N] = (d[1:N] .* e[1:N]);
      target += (sum(a2) + sum(c2));
    }
    {
      FnValidateSize__("ma3", "N", N);
      data int ma3_2dim__ = (J + 1);
      FnValidateSize__("ma3", "J + 1", ma3_2dim__);
      matrix[N, ma3_2dim__] ma3;
      FnValidateSize__("md3", "N", N);
      FnValidateSize__("md3", "J", J);
      matrix[N, J] md3;
      for(i in 1:N) {
        for(j in 1:J) ma3[i, (j + 1)] = ((ma3[i, j] + mb[i, j]) + mc[i, j]);
        md3[i, 1:J] = (me[i, 1:J] .* mf[i, 1:J]);
      }
      target += (sum(ma3) + sum(md3));
    }
    {
      data int a4_1dim__ = (N + 1);
      FnValidateSize__("a4", "N + 1", a4_1dim__);
      vector[a4_1dim__] a4;
      real total4;
      total4 = promote(0, real, var);
      for(n in 1:N) {
        a4[(n + 1)] = (a4[n] * b[n]);
        total4 = (total4 + d[n]);
      }
      target += (sum(a4) + total4);
    }
    {
      data int a5_1dim__ = (N + 1);
      FnValidateSize__("a5", "N + 1", a5_1dim__);
      vector[a5_1dim__] a5;
      FnValidateSize__("c5", "N", N);
      vector[N] c5;
      for(n in 1:N) {
        real dd5;
        dd5 = D[n];
        a5[(n + 1)] = (a5[n] * b[n]);
        c5[n] = (dd5 * e[n]);
      }
      target += (sum(a5) + sum(c5));
    }
    target += normal_lupdf(mu, promote(0, real, data), promote(1, real, data));
  } }

generate_quantities {
  data real
    mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var mu))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real mu;
  FnReadData__(mu, context__, "mu");
  (FnWriteParam(unconstrain_opt(Identity))(var mu))__(); }
output_vars {
  parameters real mu; //real
}
