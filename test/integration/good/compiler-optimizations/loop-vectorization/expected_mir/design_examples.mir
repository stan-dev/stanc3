/* $ stanc -fvectorize-loops --debug-optimized-mir-pretty ../design_examples.stan : [exit 0] */

input_vars {
  int N;
  int J;
  int k;
  array[int, N] county_idx;
  array[int, N] idx;
  vector[N] log_uppm;
  vector[N] floor_measure;
  vector[N] log_radon;
  vector[N] x;
  vector[N] u;
  vector[N] v0;
  vector[N] a0; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  FnReadData__(N, context__, "N");
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int J;
  FnReadData__(J, context__, "J");
  (FnCheck(trans(Lower 1))(var_name J)(var J))__(1);
  data int k;
  FnReadData__(k, context__, "k");
  (FnCheck(trans(Lower 0))(var_name k)(var k))__(0);
  FnValidateSize__("county_idx", "N", N);
  data array[int, N] county_idx;
  FnReadData__(county_idx, context__, "county_idx");
  (FnCheck(trans(Lower 1))(var_name county_idx)(var county_idx))__(1);
  (FnCheck(trans(Upper J))(var_name county_idx)(var county_idx))__(J);
  FnValidateSize__("idx", "N", N);
  data array[int, N] idx;
  FnReadData__(idx, context__, "idx");
  (FnCheck(trans(Lower 1))(var_name idx)(var idx))__(1);
  (FnCheck(trans(Upper N))(var_name idx)(var idx))__(N);
  FnValidateSize__("log_uppm", "N", N);
  data vector[N] log_uppm;
  FnReadData__(log_uppm, context__, "log_uppm");
  FnValidateSize__("floor_measure", "N", N);
  data vector[N] floor_measure;
  FnReadData__(floor_measure, context__, "floor_measure");
  FnValidateSize__("log_radon", "N", N);
  data vector[N] log_radon;
  FnReadData__(log_radon, context__, "log_radon");
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  FnReadData__(x, context__, "x");
  FnValidateSize__("u", "N", N);
  data vector[N] u;
  FnReadData__(u, context__, "u");
  FnValidateSize__("v0", "N", N);
  data vector[N] v0;
  FnReadData__(v0, context__, "v0");
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  FnReadData__(a0, context__, "a0");
  FnValidateSize__("alpha", "J", J); }

log_prob {
  vector[J]
    alpha = (FnReadParam(constrain Identity)(dims(J))(mem_pattern AoS))__(
    );
  vector[2]
    beta = (FnReadParam(constrain Identity)(dims(2))(mem_pattern AoS))__(
    );
  real
    sigma_y = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    {
      FnValidateSize__("mu1", "N", N);
      vector[N] mu1;
      FnValidateSize__("muj1", "N", N);
      vector[N] muj1;
      muj1[1:N] = (alpha[county_idx[1:N]] + (log_uppm[1:N] * beta[1]));
      mu1[1:N] = (muj1[1:N] + (floor_measure[1:N] * beta[2]));
      target += normal_lpdf(log_radon[1:N], mu1[1:N], sigma_y);
    }
    {
      FnValidateSize__("mu2", "N", N);
      vector[N] mu2;
      FnValidateSize__("v2", "N", N);
      vector[N] v2;
      v2 = v0;
      mu2[1:N] = (v2[1:N] + promote(1, real, data));
      v2[1:N] = x[1:N];
      target += (sum(mu2) + sum(v2));
    }
    {
      FnValidateSize__("v7", "N", N);
      vector[N] v7;
      v7 = v0;
      FnValidateSize__("y7", "N", N);
      vector[N] y7;
      y7 = v0;
      v7[2:N] = x[2:N];
      y7[2:N] = v7[(2 - 1):(N - 1)];
      target += (sum(v7) + sum(y7));
    }
    {
      FnValidateSize__("v10", "N", N);
      matrix[N, 2] v10;
      v10 = rep_matrix(promote(0, real, data), N, 2);
      FnValidateSize__("w10", "N", N);
      vector[N] w10;
      v10[1:N, 1] = x[1:N];
      w10[1:N] = v10[1:N, 2];
      target += (sum(v10) + sum(w10));
    }
    {
      FnValidateSize__("a11", "N", N);
      vector[N] a11;
      a11 = a0;
      a11[1:(N - 1)] = (a11[(1 + 1):((N - 1) + 1)] + promote(1, real, data));
      target += sum(a11);
    }
    {
      data int v12_1dim__ = (N + k);
      FnValidateSize__("v12", "N + k", v12_1dim__);
      vector[v12_1dim__] v12;
      v12 = rep_vector(promote(0, real, data), (N + k));
      FnValidateSize__("y12", "N", N);
      vector[N] y12;
      v12[(1 + k):(N + k)] = x[1:N];
      y12[1:N] = (v12[(1 + k):(N + k)] * promote(2, real, data));
      target += (sum(v12) + sum(y12));
    }
    {
      FnValidateSize__("mu3", "N", N);
      vector[N] mu3;
      mu3[1:N] = (promote(2, real, data) * x[1:N]);
      for(n in 1:N) FnPrint__(mu3[n]);
      target += sum(mu3);
    }
    {
      FnValidateSize__("v4", "N", N);
      vector[N] v4;
      v4 = v0;
      for(n in 1:N) FnPrint__(v4[n]);
      v4[1:N] = x[1:N];
      target += sum(v4);
    }
    {
      FnValidateSize__("v5", "N", N);
      vector[N] v5;
      v5 = v0;
      for(n in 1:N) {
        FnPrint__(v5[n]);
        v5[n] = x[n];
        FnPrint__(v5[n]);
      }
      target += sum(v5);
    }
    {
      FnValidateSize__("v6", "N", N);
      vector[N] v6;
      v6 = v0;
      for(n in 2:N) {
        v6[n] = (v6[(n - 1)] + u[n]);
      }
      target += sum(v6);
    }
    {
      FnValidateSize__("mu8", "N", N);
      vector[N] mu8;
      for(n in 1:N) {
        real t8;
        t8 = (promote(2, real, data) * x[n]);
        mu8[n] = (t8 + promote(1, real, data));
      }
      target += sum(mu8);
    }
    {
      FnValidateSize__("v9a", "N", N);
      vector[N] v9a;
      v9a = v0;
      for(n in 1:N) {
        v9a[n] = x[n];
        target += sum(v9a);
      }
    }
    {
      FnValidateSize__("v9b", "N", N);
      vector[N] v9b;
      v9b = v0;
      FnValidateSize__("y9b", "N", N);
      vector[N] y9b;
      for(n in 1:N) {
        v9b[idx[n]] = x[n];
        y9b[n] = v9b[idx[n]];
      }
      target += (sum(v9b) + sum(y9b));
    }
    {
      FnValidateSize__("y9c", "N", N);
      vector[N] y9c;
      for(n in 1:N) {
        vector[2] t9c;
        t9c[1] = x[n];
        y9c[n] = t9c[1];
      }
      target += sum(y9c);
    }
  } }

rev_log_prob {
  vector[J]
    alpha = (FnReadParam(constrain Identity)(dims(J))(mem_pattern AoS))__(
    );
  vector[2]
    beta = (FnReadParam(constrain Identity)(dims(2))(mem_pattern AoS))__(
    );
  real
    sigma_y = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    {
      FnValidateSize__("mu1", "N", N);
      vector[N] mu1;
      FnValidateSize__("muj1", "N", N);
      vector[N] muj1;
      muj1[1:N] = (alpha[county_idx[1:N]] + (log_uppm[1:N] * beta[1]));
      mu1[1:N] = (muj1[1:N] + (floor_measure[1:N] * beta[2]));
      target += normal_lpdf(log_radon[1:N], mu1[1:N], sigma_y);
    }
    {
      FnValidateSize__("mu2", "N", N);
      vector[N] mu2;
      FnValidateSize__("v2", "N", N);
      vector[N] v2;
      v2 = v0;
      mu2[1:N] = (v2[1:N] + promote(1, real, data));
      v2[1:N] = x[1:N];
      target += (sum(mu2) + sum(v2));
    }
    {
      FnValidateSize__("v7", "N", N);
      vector[N] v7;
      v7 = v0;
      FnValidateSize__("y7", "N", N);
      vector[N] y7;
      y7 = v0;
      v7[2:N] = x[2:N];
      y7[2:N] = v7[(2 - 1):(N - 1)];
      target += (sum(v7) + sum(y7));
    }
    {
      FnValidateSize__("v10", "N", N);
      matrix[N, 2] v10;
      v10 = rep_matrix(promote(0, real, data), N, 2);
      FnValidateSize__("w10", "N", N);
      vector[N] w10;
      v10[1:N, 1] = x[1:N];
      w10[1:N] = v10[1:N, 2];
      target += (sum(v10) + sum(w10));
    }
    {
      FnValidateSize__("a11", "N", N);
      vector[N] a11;
      a11 = a0;
      a11[1:(N - 1)] = (a11[(1 + 1):((N - 1) + 1)] + promote(1, real, data));
      target += sum(a11);
    }
    {
      data int v12_1dim__ = (N + k);
      FnValidateSize__("v12", "N + k", v12_1dim__);
      vector[v12_1dim__] v12;
      v12 = rep_vector(promote(0, real, data), (N + k));
      FnValidateSize__("y12", "N", N);
      vector[N] y12;
      v12[(1 + k):(N + k)] = x[1:N];
      y12[1:N] = (v12[(1 + k):(N + k)] * promote(2, real, data));
      target += (sum(v12) + sum(y12));
    }
    {
      FnValidateSize__("mu3", "N", N);
      vector[N] mu3;
      mu3[1:N] = (promote(2, real, data) * x[1:N]);
      for(n in 1:N) FnPrint__(mu3[n]);
      target += sum(mu3);
    }
    {
      FnValidateSize__("v4", "N", N);
      vector[N] v4;
      v4 = v0;
      for(n in 1:N) FnPrint__(v4[n]);
      v4[1:N] = x[1:N];
      target += sum(v4);
    }
    {
      FnValidateSize__("v5", "N", N);
      vector[N] v5;
      v5 = v0;
      for(n in 1:N) {
        FnPrint__(v5[n]);
        v5[n] = x[n];
        FnPrint__(v5[n]);
      }
      target += sum(v5);
    }
    {
      FnValidateSize__("v6", "N", N);
      vector[N] v6;
      v6 = v0;
      for(n in 2:N) {
        v6[n] = (v6[(n - 1)] + u[n]);
      }
      target += sum(v6);
    }
    {
      FnValidateSize__("mu8", "N", N);
      vector[N] mu8;
      for(n in 1:N) {
        real t8;
        t8 = (promote(2, real, data) * x[n]);
        mu8[n] = (t8 + promote(1, real, data));
      }
      target += sum(mu8);
    }
    {
      FnValidateSize__("v9a", "N", N);
      vector[N] v9a;
      v9a = v0;
      for(n in 1:N) {
        v9a[n] = x[n];
        target += sum(v9a);
      }
    }
    {
      FnValidateSize__("v9b", "N", N);
      vector[N] v9b;
      v9b = v0;
      FnValidateSize__("y9b", "N", N);
      vector[N] y9b;
      for(n in 1:N) {
        v9b[idx[n]] = x[n];
        y9b[n] = v9b[idx[n]];
      }
      target += (sum(v9b) + sum(y9b));
    }
    {
      FnValidateSize__("y9c", "N", N);
      vector[N] y9c;
      for(n in 1:N) {
        vector[2] t9c;
        t9c[1] = x[n];
        y9c[n] = t9c[1];
      }
      target += sum(y9c);
    }
  } }

generate_quantities {
  data vector[J]
    alpha = (FnReadParam(constrain Identity)(dims(J))(mem_pattern AoS))__(
    );
  data vector[2]
    beta = (FnReadParam(constrain Identity)(dims(2))(mem_pattern AoS))__(
    );
  data real
    sigma_y = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var alpha))__();
  (FnWriteParam(unconstrain_opt())(var beta))__();
  (FnWriteParam(unconstrain_opt())(var sigma_y))__();
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  data int pos__;
  pos__ = 1;
  vector[J] alpha;
  FnReadData__(alpha, context__, "alpha");
  (FnWriteParam(unconstrain_opt(Identity))(var alpha))__();
  vector[2] beta;
  FnReadData__(beta, context__, "beta");
  (FnWriteParam(unconstrain_opt(Identity))(var beta))__();
  real sigma_y;
  FnReadData__(sigma_y, context__, "sigma_y");
  (FnWriteParam(unconstrain_opt((Lower 0)))(var sigma_y))__(); }

output_vars {
  parameters vector[J] alpha; //vector[J]
  parameters vector[2] beta; //vector[2]
  parameters real sigma_y; //real
}
