      for(n in 1:N) {
        FnPrint__(v[n]);
        v[n] = x[n];
        FnPrint__(v[n]);
      }
      target += sum(v);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 2:N) {
        v[n] = (v[(n - 1)] + u[n]);
      }
      target += sum(v);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      FnValidateSize__("y", "N", N);
      vector[N] y;
      y = v0;
      for(n in 2:N) {
        v[n] = x[n];
        y[n] = v[(n - 1)];
      }
      target += (sum(v) + sum(y));
    }
    {
      FnValidateSize__("mu", "N", N);
      vector[N] mu;
      for(n in 1:N) {
        real t;
        t = (promote(2, real, data) * x[n]);
        mu[n] = (t + promote(1, real, data));
      }
      target += sum(mu);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 1:N) {
        v[n] = x[n];
        target += sum(v);
      }
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      FnValidateSize__("y", "N", N);
      vector[N] y;
      for(n in 1:N) {
        v[idx[n]] = x[n];
        y[n] = v[idx[n]];
      }
      target += (sum(v) + sum(y));
    }
    {
      FnValidateSize__("y", "N", N);
      vector[N] y;
      for(n in 1:N) {
        vector[2] t;
        t[1] = x[n];
        y[n] = t[1];
      }
      target += sum(y);
    }
    {
      FnValidateSize__("v", "N", N);
      matrix[N, 2] v;
      v = rep_matrix(promote(0, real, data), N, 2);
      FnValidateSize__("w", "N", N);
      vector[N] w;
      for(n in 1:N) {
