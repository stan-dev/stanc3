  $ stanc -fvectorize-loops --debug-optimized-mir-pretty tsvc_linear_dependence.stan
input_vars {
  int N;
  int k;
  vector[(N + 1)] a0;
  vector[(N + k)] a0k;
  vector[N] b; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  N = FnReadData__("N")[1];
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int k;
  k = FnReadData__("k")[1];
  (FnCheck(trans(Lower 0))(var_name k)(var k))__(0);
  data int a0_1dim__ = (N + 1);
  FnValidateSize__("a0", "N + 1", a0_1dim__);
  data vector[a0_1dim__] a0;
  {
    array[] real a0_flat__;
    a0_flat__ = FnReadData__("a0");
    pos__ = 1;
    for(sym1__ in 1:(N + 1)) {
      a0[sym1__] = a0_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  data int a0k_1dim__ = (N + k);
  FnValidateSize__("a0k", "N + k", a0k_1dim__);
  data vector[a0k_1dim__] a0k;
  {
    array[] real a0k_flat__;
    a0k_flat__ = FnReadData__("a0k");
    pos__ = 1;
    for(sym1__ in 1:(N + k)) {
      a0k[sym1__] = a0k_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  {
    array[] real b_flat__;
    b_flat__ = FnReadData__("b");
    pos__ = 1;
    for(sym1__ in 1:N) {
      b[sym1__] = b_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  } }

log_prob {
  {
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      for(n in 1:N) {
        a[(n + 1)] = (a[n] + b[n]);
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      for(n in 2:N) {
        a[n] = (a[1] + b[n]);
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      for(n in 1:N) {
        a[n] = (a[(N %/% 2)] + b[n]);
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      for(n in 1:N) {
        a[n] = a[1];
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      int j;
      j = 1;
      for(n in 1:(N - 1)) {
        a[n] = (a[j] + b[n]);
        j = (j + 1);
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + k);
      FnValidateSize__("a", "N + k", a_1dim__);
      vector[a_1dim__] a;
      a = a0k;
      for(n in 1:N) {
        a[n] = (a[(n + k)] + b[n]);
      }
      target += sum(a);
    }
  } }

rev_log_prob {
  {
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      for(n in 1:N) {
        a[(n + 1)] = (a[n] + b[n]);
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      for(n in 2:N) {
        a[n] = (a[1] + b[n]);
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      for(n in 1:N) {
        a[n] = (a[(N %/% 2)] + b[n]);
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      for(n in 1:N) {
        a[n] = a[1];
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + 1);
      FnValidateSize__("a", "N + 1", a_1dim__);
      vector[a_1dim__] a;
      a = a0;
      int j;
      j = 1;
      for(n in 1:(N - 1)) {
        a[n] = (a[j] + b[n]);
        j = (j + 1);
      }
      target += sum(a);
    }
    {
      data int a_1dim__ = (N + k);
      FnValidateSize__("a", "N + k", a_1dim__);
      vector[a_1dim__] a;
      a = a0k;
      for(n in 1:N) {
        a[n] = (a[(n + k)] + b[n]);
      }
      target += sum(a);
    }
  } }

generate_quantities {
  if(PNot__(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(PNot__(emit_generated_quantities__)) {
    return;
  } }

[exit 0]
