  $ stanc -fvectorize-loops --debug-optimized-mir-pretty llvm_loop_distribute.stan

input_vars {
  int N;
  int J;
  vector[N] b;
  vector[N] d;
  vector[N] e;
  vector[N] D;
  matrix[N, J] mb;
  matrix[N, J] mc;
  matrix[N, J] me;
  matrix[N, J] mf; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  N = FnReadData__("N")[1];
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  data int J;
  J = FnReadData__("J")[1];
  (FnCheck(trans(Lower 1))(var_name J)(var J))__(1);
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  {
    array[] real b_flat__;
    b_flat__ = FnReadData__("b");
    pos__ = 1;
    for(sym1__ in 1:N) {
      b[sym1__] = b_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  {
    array[] real d_flat__;
    d_flat__ = FnReadData__("d");
    pos__ = 1;
    for(sym1__ in 1:N) {
      d[sym1__] = d_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  {
    array[] real e_flat__;
    e_flat__ = FnReadData__("e");
    pos__ = 1;
    for(sym1__ in 1:N) {
      e[sym1__] = e_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("D", "N", N);
  data vector[N] D;
  {
    array[] real D_flat__;
    D_flat__ = FnReadData__("D");
    pos__ = 1;
    for(sym1__ in 1:N) {
      D[sym1__] = D_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("mb", "N", N);
  FnValidateSize__("mb", "J", J);
  data matrix[N, J] mb;
  {
    array[] real mb_flat__;
    mb_flat__ = FnReadData__("mb");
    pos__ = 1;
    for(sym1__ in 1:J) {
      for(sym2__ in 1:N) {
        mb[sym2__, sym1__] = mb_flat__[pos__];
        pos__ = (pos__ + 1);
      }
    }
  }
  FnValidateSize__("mc", "N", N);
  FnValidateSize__("mc", "J", J);
  data matrix[N, J] mc;
  {
    array[] real mc_flat__;
    mc_flat__ = FnReadData__("mc");
    pos__ = 1;
    for(sym1__ in 1:J) {
      for(sym2__ in 1:N) {
        mc[sym2__, sym1__] = mc_flat__[pos__];
        pos__ = (pos__ + 1);
      }
    }
  }
  FnValidateSize__("me", "N", N);
  FnValidateSize__("me", "J", J);
  data matrix[N, J] me;
  {
    array[] real me_flat__;
    me_flat__ = FnReadData__("me");
    pos__ = 1;
    for(sym1__ in 1:J) {
      for(sym2__ in 1:N) {
        me[sym2__, sym1__] = me_flat__[pos__];
        pos__ = (pos__ + 1);
      }
    }
  }
  FnValidateSize__("mf", "N", N);
  FnValidateSize__("mf", "J", J);
  data matrix[N, J] mf;
  {
    array[] real mf_flat__;
    mf_flat__ = FnReadData__("mf");
    pos__ = 1;
    for(sym1__ in 1:J) {
      for(sym2__ in 1:N) {
        mf[sym2__, sym1__] = mf_flat__[pos__];
        pos__ = (pos__ + 1);
      }
    }
  } }

log_prob {
  real mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  {
    data int a_1dim__ = (N + 1);
    FnValidateSize__("a", "N + 1", a_1dim__);
    vector[a_1dim__] a;
    FnValidateSize__("c", "N", N);
    vector[N] c;
    real total;
    total = promote(0, real, var);
    for(n in 1:N) a[(n + 1)] = (a[n] * b[n]);
    c[1:N] = (d[1:N] .* e[1:N]);
    for(n in 1:N) {
      real dd;
      dd = D[n];
      a[(n + 1)] = (a[n] * b[n]);
      c[n] = (dd * e[n]);
    }
    for(n in 1:N) {
      a[(n + 1)] = (a[n] * b[n]);
      total = (total + c[n]);
    }
    {
      FnValidateSize__("ma", "N", N);
      data int ma_2dim__ = (J + 1);
      FnValidateSize__("ma", "J + 1", ma_2dim__);
      matrix[N, ma_2dim__] ma;
      FnValidateSize__("md", "N", N);
      FnValidateSize__("md", "J", J);
      matrix[N, J] md;
      for(i in 1:N) {
        for(j in 1:J) ma[i, (j + 1)] = ((ma[i, j] + mb[i, j]) + mc[i, j]);
        md[i, 1:J] = (me[i, 1:J] .* mf[i, 1:J]);
      }
      target += (sum(ma) + sum(md));
    }
    a[1:N] = (b[1:N] .* c[1:N]);
    target += ((sum(a) + sum(c)) + total);
    target += normal_lupdf(mu, promote(0, real, data), promote(1, real, data));
  } }

rev_log_prob {
  real mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  {
    data int a_1dim__ = (N + 1);
    FnValidateSize__("a", "N + 1", a_1dim__);
    vector[a_1dim__] a;
    FnValidateSize__("c", "N", N);
    vector[N] c;
    real total;
    total = promote(0, real, var);
    for(n in 1:N) a[(n + 1)] = (a[n] * b[n]);
    c[1:N] = (d[1:N] .* e[1:N]);
    for(n in 1:N) {
      real dd;
      dd = D[n];
      a[(n + 1)] = (a[n] * b[n]);
      c[n] = (dd * e[n]);
    }
    for(n in 1:N) {
      a[(n + 1)] = (a[n] * b[n]);
      total = (total + c[n]);
    }
    {
      FnValidateSize__("ma", "N", N);
      data int ma_2dim__ = (J + 1);
      FnValidateSize__("ma", "J + 1", ma_2dim__);
      matrix[N, ma_2dim__] ma;
      FnValidateSize__("md", "N", N);
      FnValidateSize__("md", "J", J);
      matrix[N, J] md;
      for(i in 1:N) {
        for(j in 1:J) ma[i, (j + 1)] = ((ma[i, j] + mb[i, j]) + mc[i, j]);
        md[i, 1:J] = (me[i, 1:J] .* mf[i, 1:J]);
      }
      target += (sum(ma) + sum(md));
    }
    a[1:N] = (b[1:N] .* c[1:N]);
    target += ((sum(a) + sum(c)) + total);
    target += normal_lupdf(mu, promote(0, real, data), promote(1, real, data));
  } }

generate_quantities {
  data real
    mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var mu))__();
  if(PNot__(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(PNot__(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real mu;
  mu = FnReadData__("mu")[1];
  (FnWriteParam(unconstrain_opt(Identity))(var mu))__(); }
output_vars {
  parameters real mu; //real
}
[exit 0]
