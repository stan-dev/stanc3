  $ stanc -fvectorize-loops --debug-optimized-mir-pretty llvm_loop_access.stan
input_vars {
  int N;
  int J;
  vector[N] b;
  vector[J] w;
  array[int, N] idx; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  N = FnReadData__("N")[1];
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  data int J;
  J = FnReadData__("J")[1];
  (FnCheck(trans(Lower 1))(var_name J)(var J))__(1);
  FnValidateSize__("b", "N", N);
  data vector[N] b;
  {
    array[] real b_flat__;
    b_flat__ = FnReadData__("b");
    pos__ = 1;
    for(sym1__ in 1:N) {
      b[sym1__] = b_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("w", "J", J);
  data vector[J] w;
  {
    array[] real w_flat__;
    w_flat__ = FnReadData__("w");
    pos__ = 1;
    for(sym1__ in 1:J) {
      w[sym1__] = w_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("idx", "N", N);
  data array[int, N] idx;
  idx = FnReadData__("idx");
  (FnCheck(trans(Lower 1))(var_name idx)(var idx))__(1);
  (FnCheck(trans(Upper N))(var_name idx)(var idx))__(N); }

log_prob {
  real mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  {
    data int a_1dim__ = (N + 8);
    FnValidateSize__("a", "N + 8", a_1dim__);
    vector[a_1dim__] a;
    FnValidateSize__("c", "N", N);
    vector[N] c;
    a[(1 + 8):(N + 8)] = (b[1:N] + promote(2, real, data));
    c[1:N] = (a[1:N] * promote(2, real, data));
    a[(1 + 1):(N + 1)] = (b[1:N] + promote(1, real, data));
    a[1:N] = (b[1:N] + promote(2, real, data));
    c[1:N] = (a[1:N] * promote(2, real, data));
    for(n in 1:N) {
      a[idx[n]] = b[n];
      c[n] = a[idx[n]];
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      for(i in 1:N) {
        for(j in 1:J) {
          v[i] = (w[j] + v[i]);
        }
      }
      target += sum(v);
    }
    for(n in 1:N) {
      a[(n + 4)] = (a[n] * promote(2, real, data));
    }
    target += (sum(a) + sum(c));
    target += normal_lupdf(mu, promote(0, real, data), promote(1, real, data));
  } }

rev_log_prob {
  real mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__();
  {
    data int a_1dim__ = (N + 8);
    FnValidateSize__("a", "N + 8", a_1dim__);
    vector[a_1dim__] a;
    FnValidateSize__("c", "N", N);
    vector[N] c;
    a[(1 + 8):(N + 8)] = (b[1:N] + promote(2, real, data));
    c[1:N] = (a[1:N] * promote(2, real, data));
    a[(1 + 1):(N + 1)] = (b[1:N] + promote(1, real, data));
    a[1:N] = (b[1:N] + promote(2, real, data));
    c[1:N] = (a[1:N] * promote(2, real, data));
    for(n in 1:N) {
      a[idx[n]] = b[n];
      c[n] = a[idx[n]];
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      for(i in 1:N) {
        for(j in 1:J) {
          v[i] = (w[j] + v[i]);
        }
      }
      target += sum(v);
    }
    for(n in 1:N) {
      a[(n + 4)] = (a[n] * promote(2, real, data));
    }
    target += (sum(a) + sum(c));
    target += normal_lupdf(mu, promote(0, real, data), promote(1, real, data));
  } }

generate_quantities {
  data real
    mu = (FnReadParam(constrain Identity)(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var mu))__();
  if(PNot__(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(PNot__(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  real mu;
  mu = FnReadData__("mu")[1];
  (FnWriteParam(unconstrain_opt(Identity))(var mu))__(); }
output_vars {
  parameters real mu; //real
}
[exit 0]
