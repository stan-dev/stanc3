  $ stanc -fvectorize-loops --debug-optimized-mir-pretty tsvc_control_flow.stan
functions {
  void foo() {
    {
      FnPrint__("foo");
    }
  } }

input_vars {
  int N;
  vector[N] a0;
  vector[N] b0;
  vector[N] c;
  vector[N] d;
  vector[N] e; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  N = FnReadData__("N")[1];
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  {
    array[] real a0_flat__;
    a0_flat__ = FnReadData__("a0");
    pos__ = 1;
    for(sym1__ in 1:N) {
      a0[sym1__] = a0_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("b0", "N", N);
  data vector[N] b0;
  {
    array[] real b0_flat__;
    b0_flat__ = FnReadData__("b0");
    pos__ = 1;
    for(sym1__ in 1:N) {
      b0[sym1__] = b0_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  {
    array[] real c_flat__;
    c_flat__ = FnReadData__("c");
    pos__ = 1;
    for(sym1__ in 1:N) {
      c[sym1__] = c_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  {
    array[] real d_flat__;
    d_flat__ = FnReadData__("d");
    pos__ = 1;
    for(sym1__ in 1:N) {
      d[sym1__] = d_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  {
    array[] real e_flat__;
    e_flat__ = FnReadData__("e");
    pos__ = 1;
    for(sym1__ in 1:N) {
      e[sym1__] = e_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  } }

log_prob {
  {
    {
      FnValidateSize__("b1", "N", N);
      vector[N] b1;
      b1 = b0;
      FnValidateSize__("x1", "N", N);
      vector[N] x1;
      for(n in 1:N) foo();
      x1[1:N] = (b1[1:N] + (d[1:N] .* d[1:N]));
      b1[1:N] = (c[1:N] + (d[1:N] .* e[1:N]));
      target += (sum(b1) + sum(x1));
    }
    {
      FnValidateSize__("a2", "N", N);
      vector[N] a2;
      a2 = a0;
      for(n in 1:N) if((d[n] < 0)) {
        FnReject__("neg");
      }
      a2[1:N] = (a2[1:N] + (b0[1:N] .* c[1:N]));
      target += sum(a2);
    }
    {
      FnValidateSize__("a3", "N", N);
      vector[N] a3;
      a3 = a0;
      for(n in 1:N) {
        if((b0[n] > 0)) {
          a3[n] = (a3[n] + (b0[n] * c[n]));
        }
      }
      target += sum(a3);
    }
    {
      FnValidateSize__("a4", "N", N);
      vector[N] a4;
      a4 = a0;
      for(n in 1:N) {
        if((d[n] < 0)) {
          a4[n] = (a4[n] + (b0[n] * c[n]));
        } else {
          if((d[n] == 0)) {
            a4[n] = (a4[n] + (b0[n] * b0[n]));
          } else {
            a4[n] = (a4[n] + (c[n] * c[n]));
          }
        }
      }
      target += sum(a4);
    }
    {
      FnValidateSize__("a5", "N", N);
      vector[N] a5;
      a5 = a0;
      for(n in 1:N) {
        a5[n] = (b0[n] + (c[n] * promote((n + 1), real, data)));
      }
      target += sum(a5);
    }
    {
      FnValidateSize__("a6", "N", N);
      vector[N] a6;
      a6 = a0;
      for(n in 1:N) {
        a6[n] = (a6[n] + (b0[n] .* c[n]));
        if((c[n] > b0[n])) {
          break;
        }
      }
      target += sum(a6);
    }
  } }

rev_log_prob {
  {
    {
      FnValidateSize__("b1", "N", N);
      vector[N] b1;
      b1 = b0;
      FnValidateSize__("x1", "N", N);
      vector[N] x1;
      for(n in 1:N) foo();
      x1[1:N] = (b1[1:N] + (d[1:N] .* d[1:N]));
      b1[1:N] = (c[1:N] + (d[1:N] .* e[1:N]));
      target += (sum(b1) + sum(x1));
    }
    {
      FnValidateSize__("a2", "N", N);
      vector[N] a2;
      a2 = a0;
      for(n in 1:N) if((d[n] < 0)) {
        FnReject__("neg");
      }
      a2[1:N] = (a2[1:N] + (b0[1:N] .* c[1:N]));
      target += sum(a2);
    }
    {
      FnValidateSize__("a3", "N", N);
      vector[N] a3;
      a3 = a0;
      for(n in 1:N) {
        if((b0[n] > 0)) {
          a3[n] = (a3[n] + (b0[n] * c[n]));
        }
      }
      target += sum(a3);
    }
    {
      FnValidateSize__("a4", "N", N);
      vector[N] a4;
      a4 = a0;
      for(n in 1:N) {
        if((d[n] < 0)) {
          a4[n] = (a4[n] + (b0[n] * c[n]));
        } else {
          if((d[n] == 0)) {
            a4[n] = (a4[n] + (b0[n] * b0[n]));
          } else {
            a4[n] = (a4[n] + (c[n] * c[n]));
          }
        }
      }
      target += sum(a4);
    }
    {
      FnValidateSize__("a5", "N", N);
      vector[N] a5;
      a5 = a0;
      for(n in 1:N) {
        a5[n] = (b0[n] + (c[n] * promote((n + 1), real, data)));
      }
      target += sum(a5);
    }
    {
      FnValidateSize__("a6", "N", N);
      vector[N] a6;
      a6 = a0;
      for(n in 1:N) {
        a6[n] = (a6[n] + (b0[n] .* c[n]));
        if((c[n] > b0[n])) {
          break;
        }
      }
      target += sum(a6);
    }
  } }

generate_quantities {
  if(!(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(!(emit_generated_quantities__)) {
    return;
  } }

[exit 0]
