  $ stanc -fvectorize-loops --debug-optimized-mir-pretty tsvc_control_flow.stan
functions {
  void foo() {
    {
      FnPrint__("foo");
    }
  } }

input_vars {
  int N;
  vector[N] a0;
  vector[N] b0;
  vector[N] c;
  vector[N] d;
  vector[N] e; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  N = FnReadData__("N")[1];
  (FnCheck(trans(Lower 1))(var_name N)(var N))__(1);
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  {
    array[] real a0_flat__;
    a0_flat__ = FnReadData__("a0");
    pos__ = 1;
    for(sym1__ in 1:N) {
      a0[sym1__] = a0_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("b0", "N", N);
  data vector[N] b0;
  {
    array[] real b0_flat__;
    b0_flat__ = FnReadData__("b0");
    pos__ = 1;
    for(sym1__ in 1:N) {
      b0[sym1__] = b0_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("c", "N", N);
  data vector[N] c;
  {
    array[] real c_flat__;
    c_flat__ = FnReadData__("c");
    pos__ = 1;
    for(sym1__ in 1:N) {
      c[sym1__] = c_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("d", "N", N);
  data vector[N] d;
  {
    array[] real d_flat__;
    d_flat__ = FnReadData__("d");
    pos__ = 1;
    for(sym1__ in 1:N) {
      d[sym1__] = d_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("e", "N", N);
  data vector[N] e;
  {
    array[] real e_flat__;
    e_flat__ = FnReadData__("e");
    pos__ = 1;
    for(sym1__ in 1:N) {
      e[sym1__] = e_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  } }

log_prob {
  {
    FnValidateSize__("a", "N", N);
    vector[N] a;
    a = a0;
    FnValidateSize__("b", "N", N);
    vector[N] b;
    b = b0;
    FnValidateSize__("x", "N", N);
    vector[N] x;
    for(n in 1:N) {
      if((b[n] > 0)) {
        a[n] = (a[n] + (b[n] * c[n]));
      }
    }
    for(n in 1:N) {
      if((d[n] < 0)) {
        a[n] = (a[n] + (b[n] * c[n]));
      } else {
        if((d[n] == 0)) {
          a[n] = (a[n] + (b[n] * b[n]));
        } else {
          a[n] = (a[n] + (c[n] * c[n]));
        }
      }
    }
    for(n in 1:N) {
      a[n] = (b[n] + (c[n] * promote((n + 1), real, data)));
    }
    for(n in 1:N) foo();
    x[1:N] = (b[1:N] + (d[1:N] .* d[1:N]));
    b[1:N] = (c[1:N] + (d[1:N] .* e[1:N]));
    for(n in 1:N) if((d[n] < 0)) {
      FnReject__("neg");
    }
    a[1:N] = (a[1:N] + (b[1:N] .* c[1:N]));
    for(n in 1:N) {
      a[n] = (a[n] + (b[n] .* c[n]));
      if((c[n] > b[n])) {
        break;
      }
    }
    target += sum(a);
    target += sum(b);
    target += sum(x);
  } }

rev_log_prob {
  {
    FnValidateSize__("a", "N", N);
    vector[N] a;
    a = a0;
    FnValidateSize__("b", "N", N);
    vector[N] b;
    b = b0;
    FnValidateSize__("x", "N", N);
    vector[N] x;
    for(n in 1:N) {
      if((b[n] > 0)) {
        a[n] = (a[n] + (b[n] * c[n]));
      }
    }
    for(n in 1:N) {
      if((d[n] < 0)) {
        a[n] = (a[n] + (b[n] * c[n]));
      } else {
        if((d[n] == 0)) {
          a[n] = (a[n] + (b[n] * b[n]));
        } else {
          a[n] = (a[n] + (c[n] * c[n]));
        }
      }
    }
    for(n in 1:N) {
      a[n] = (b[n] + (c[n] * promote((n + 1), real, data)));
    }
    for(n in 1:N) foo();
    x[1:N] = (b[1:N] + (d[1:N] .* d[1:N]));
    b[1:N] = (c[1:N] + (d[1:N] .* e[1:N]));
    for(n in 1:N) if((d[n] < 0)) {
      FnReject__("neg");
    }
    a[1:N] = (a[1:N] + (b[1:N] .* c[1:N]));
    for(n in 1:N) {
      a[n] = (a[n] + (b[n] .* c[n]));
      if((c[n] > b[n])) {
        break;
      }
    }
    target += sum(a);
    target += sum(b);
    target += sum(x);
  } }

generate_quantities {
  if(PNot__(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(PNot__(emit_generated_quantities__)) {
    return;
  } }

[exit 0]
