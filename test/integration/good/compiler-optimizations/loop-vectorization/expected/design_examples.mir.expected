  $ stanc -fvectorize-loops --debug-optimized-mir-pretty design_examples.stan

input_vars {
  int N;
  int J;
  int k;
  array[int, N] county_idx;
  array[int, N] idx;
  vector[N] log_uppm;
  vector[N] floor_measure;
  vector[N] log_radon;
  vector[N] x;
  vector[N] u;
  vector[N] v0;
  vector[N] a0; }

prepare_data {
  data int pos__;
  pos__ = 1;
  data int N;
  N = FnReadData__("N")[1];
  (FnCheck(trans(Lower 2))(var_name N)(var N))__(2);
  data int J;
  J = FnReadData__("J")[1];
  (FnCheck(trans(Lower 1))(var_name J)(var J))__(1);
  data int k;
  k = FnReadData__("k")[1];
  (FnCheck(trans(Lower 0))(var_name k)(var k))__(0);
  FnValidateSize__("county_idx", "N", N);
  data array[int, N] county_idx;
  county_idx = FnReadData__("county_idx");
  (FnCheck(trans(Lower 1))(var_name county_idx)(var county_idx))__(1);
  (FnCheck(trans(Upper J))(var_name county_idx)(var county_idx))__(J);
  FnValidateSize__("idx", "N", N);
  data array[int, N] idx;
  idx = FnReadData__("idx");
  (FnCheck(trans(Lower 1))(var_name idx)(var idx))__(1);
  (FnCheck(trans(Upper N))(var_name idx)(var idx))__(N);
  FnValidateSize__("log_uppm", "N", N);
  data vector[N] log_uppm;
  {
    array[] real log_uppm_flat__;
    log_uppm_flat__ = FnReadData__("log_uppm");
    pos__ = 1;
    for(sym1__ in 1:N) {
      log_uppm[sym1__] = log_uppm_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("floor_measure", "N", N);
  data vector[N] floor_measure;
  {
    array[] real floor_measure_flat__;
    floor_measure_flat__ = FnReadData__("floor_measure");
    pos__ = 1;
    for(sym1__ in 1:N) {
      floor_measure[sym1__] = floor_measure_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("log_radon", "N", N);
  data vector[N] log_radon;
  {
    array[] real log_radon_flat__;
    log_radon_flat__ = FnReadData__("log_radon");
    pos__ = 1;
    for(sym1__ in 1:N) {
      log_radon[sym1__] = log_radon_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("x", "N", N);
  data vector[N] x;
  {
    array[] real x_flat__;
    x_flat__ = FnReadData__("x");
    pos__ = 1;
    for(sym1__ in 1:N) {
      x[sym1__] = x_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("u", "N", N);
  data vector[N] u;
  {
    array[] real u_flat__;
    u_flat__ = FnReadData__("u");
    pos__ = 1;
    for(sym1__ in 1:N) {
      u[sym1__] = u_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("v0", "N", N);
  data vector[N] v0;
  {
    array[] real v0_flat__;
    v0_flat__ = FnReadData__("v0");
    pos__ = 1;
    for(sym1__ in 1:N) {
      v0[sym1__] = v0_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("a0", "N", N);
  data vector[N] a0;
  {
    array[] real a0_flat__;
    a0_flat__ = FnReadData__("a0");
    pos__ = 1;
    for(sym1__ in 1:N) {
      a0[sym1__] = a0_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  FnValidateSize__("alpha", "J", J); }

log_prob {
  vector[J]
    alpha = (FnReadParam(constrain Identity)(dims(J))(mem_pattern AoS))__(
    );
  vector[2]
    beta = (FnReadParam(constrain Identity)(dims(2))(mem_pattern AoS))__(
    );
  real
    sigma_y = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    {
      FnValidateSize__("mu", "N", N);
      vector[N] mu;
      FnValidateSize__("muj", "N", N);
      vector[N] muj;
      muj[1:N] = (alpha[county_idx[1:N]] + (log_uppm[1:N] * beta[1]));
      mu[1:N] = (muj[1:N] + (floor_measure[1:N] * beta[2]));
      target += normal_lpdf(log_radon[1:N], mu[1:N], sigma_y);
    }
    {
      FnValidateSize__("mu", "N", N);
      vector[N] mu;
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      mu[1:N] = (v[1:N] + promote(1, real, data));
      v[1:N] = x[1:N];
      target += (sum(mu) + sum(v));
    }
    {
      FnValidateSize__("mu", "N", N);
      vector[N] mu;
      mu[1:N] = (promote(2, real, data) * x[1:N]);
      for(n in 1:N) FnPrint__(mu[n]);
      target += sum(mu);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 1:N) FnPrint__(v[n]);
      v[1:N] = x[1:N];
      target += sum(v);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 1:N) {
        FnPrint__(v[n]);
        v[n] = x[n];
        FnPrint__(v[n]);
      }
      target += sum(v);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 2:N) {
        v[n] = (v[(n - 1)] + u[n]);
      }
      target += sum(v);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      FnValidateSize__("y", "N", N);
      vector[N] y;
      y = v0;
      v[2:N] = x[2:N];
      y[2:N] = v[(2 - 1):(N - 1)];
      target += (sum(v) + sum(y));
    }
    {
      FnValidateSize__("mu", "N", N);
      vector[N] mu;
      for(n in 1:N) {
        real t;
        t = (promote(2, real, data) * x[n]);
        mu[n] = (t + promote(1, real, data));
      }
      target += sum(mu);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 1:N) {
        v[n] = x[n];
        target += sum(v);
      }
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      FnValidateSize__("y", "N", N);
      vector[N] y;
      for(n in 1:N) {
        v[idx[n]] = x[n];
        y[n] = v[idx[n]];
      }
      target += (sum(v) + sum(y));
    }
    {
      FnValidateSize__("y", "N", N);
      vector[N] y;
      for(n in 1:N) {
        vector[2] t;
        t[1] = x[n];
        y[n] = t[1];
      }
      target += sum(y);
    }
    {
      FnValidateSize__("v", "N", N);
      matrix[N, 2] v;
      v = rep_matrix(promote(0, real, data), N, 2);
      FnValidateSize__("w", "N", N);
      vector[N] w;
      v[1:N, 1] = x[1:N];
      w[1:N] = v[1:N, 2];
      target += (sum(v) + sum(w));
    }
    {
      FnValidateSize__("a", "N", N);
      vector[N] a;
      a = a0;
      a[1:(N - 1)] = (a[(1 + 1):((N - 1) + 1)] + promote(1, real, data));
      target += sum(a);
    }
    {
      data int v_1dim__ = (N + k);
      FnValidateSize__("v", "N + k", v_1dim__);
      vector[v_1dim__] v;
      v = rep_vector(promote(0, real, data), (N + k));
      FnValidateSize__("y", "N", N);
      vector[N] y;
      v[(1 + k):(N + k)] = x[1:N];
      y[1:N] = (v[(1 + k):(N + k)] * promote(2, real, data));
      target += (sum(v) + sum(y));
    }
  } }

rev_log_prob {
  vector[J]
    alpha = (FnReadParam(constrain Identity)(dims(J))(mem_pattern AoS))__(
    );
  vector[2]
    beta = (FnReadParam(constrain Identity)(dims(2))(mem_pattern AoS))__(
    );
  real
    sigma_y = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  {
    {
      FnValidateSize__("mu", "N", N);
      vector[N] mu;
      FnValidateSize__("muj", "N", N);
      vector[N] muj;
      muj[1:N] = (alpha[county_idx[1:N]] + (log_uppm[1:N] * beta[1]));
      mu[1:N] = (muj[1:N] + (floor_measure[1:N] * beta[2]));
      target += normal_lpdf(log_radon[1:N], mu[1:N], sigma_y);
    }
    {
      FnValidateSize__("mu", "N", N);
      vector[N] mu;
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      mu[1:N] = (v[1:N] + promote(1, real, data));
      v[1:N] = x[1:N];
      target += (sum(mu) + sum(v));
    }
    {
      FnValidateSize__("mu", "N", N);
      vector[N] mu;
      mu[1:N] = (promote(2, real, data) * x[1:N]);
      for(n in 1:N) FnPrint__(mu[n]);
      target += sum(mu);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 1:N) FnPrint__(v[n]);
      v[1:N] = x[1:N];
      target += sum(v);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 1:N) {
        FnPrint__(v[n]);
        v[n] = x[n];
        FnPrint__(v[n]);
      }
      target += sum(v);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 2:N) {
        v[n] = (v[(n - 1)] + u[n]);
      }
      target += sum(v);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      FnValidateSize__("y", "N", N);
      vector[N] y;
      y = v0;
      v[2:N] = x[2:N];
      y[2:N] = v[(2 - 1):(N - 1)];
      target += (sum(v) + sum(y));
    }
    {
      FnValidateSize__("mu", "N", N);
      vector[N] mu;
      for(n in 1:N) {
        real t;
        t = (promote(2, real, data) * x[n]);
        mu[n] = (t + promote(1, real, data));
      }
      target += sum(mu);
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      for(n in 1:N) {
        v[n] = x[n];
        target += sum(v);
      }
    }
    {
      FnValidateSize__("v", "N", N);
      vector[N] v;
      v = v0;
      FnValidateSize__("y", "N", N);
      vector[N] y;
      for(n in 1:N) {
        v[idx[n]] = x[n];
        y[n] = v[idx[n]];
      }
      target += (sum(v) + sum(y));
    }
    {
      FnValidateSize__("y", "N", N);
      vector[N] y;
      for(n in 1:N) {
        vector[2] t;
        t[1] = x[n];
        y[n] = t[1];
      }
      target += sum(y);
    }
    {
      FnValidateSize__("v", "N", N);
      matrix[N, 2] v;
      v = rep_matrix(promote(0, real, data), N, 2);
      FnValidateSize__("w", "N", N);
      vector[N] w;
      v[1:N, 1] = x[1:N];
      w[1:N] = v[1:N, 2];
      target += (sum(v) + sum(w));
    }
    {
      FnValidateSize__("a", "N", N);
      vector[N] a;
      a = a0;
      a[1:(N - 1)] = (a[(1 + 1):((N - 1) + 1)] + promote(1, real, data));
      target += sum(a);
    }
    {
      data int v_1dim__ = (N + k);
      FnValidateSize__("v", "N + k", v_1dim__);
      vector[v_1dim__] v;
      v = rep_vector(promote(0, real, data), (N + k));
      FnValidateSize__("y", "N", N);
      vector[N] y;
      v[(1 + k):(N + k)] = x[1:N];
      y[1:N] = (v[(1 + k):(N + k)] * promote(2, real, data));
      target += (sum(v) + sum(y));
    }
  } }

generate_quantities {
  data vector[J]
    alpha = (FnReadParam(constrain Identity)(dims(J))(mem_pattern AoS))__(
    );
  data vector[2]
    beta = (FnReadParam(constrain Identity)(dims(2))(mem_pattern AoS))__(
    );
  data real
    sigma_y = (FnReadParam(constrain(Lower 0))(dims())(mem_pattern AoS))__(
    );
  (FnWriteParam(unconstrain_opt())(var alpha))__();
  (FnWriteParam(unconstrain_opt())(var beta))__();
  (FnWriteParam(unconstrain_opt())(var sigma_y))__();
  if(PNot__(emit_transformed_parameters__ || emit_generated_quantities__)) {
    return;
  }
  if(PNot__(emit_generated_quantities__)) {
    return;
  } }

transform_inits {
  data int pos__;
  pos__ = 1;
  vector[J] alpha;
  {
    array[] real alpha_flat__;
    alpha_flat__ = FnReadData__("alpha");
    pos__ = 1;
    for(sym1__ in 1:J) {
      alpha[sym1__] = alpha_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  (FnWriteParam(unconstrain_opt(Identity))(var alpha))__();
  vector[2] beta;
  {
    array[] real beta_flat__;
    beta_flat__ = FnReadData__("beta");
    pos__ = 1;
    for(sym1__ in 1:2) {
      beta[sym1__] = beta_flat__[pos__];
      pos__ = (pos__ + 1);
    }
  }
  (FnWriteParam(unconstrain_opt(Identity))(var beta))__();
  real sigma_y;
  sigma_y = FnReadData__("sigma_y")[1];
  (FnWriteParam(unconstrain_opt((Lower 0)))(var sigma_y))__(); }

output_vars {
  parameters vector[J] alpha; //vector[J]
  parameters vector[2] beta; //vector[2]
  parameters real sigma_y; //real
}
[exit 0]
