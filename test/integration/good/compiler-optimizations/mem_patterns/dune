(subdir
 dunes
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    cpp.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "-fsoa --print-cpp"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    mir.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     mir
     "-fsoa --debug-optimized-mir --debug-mem-patterns"
     %{stanfiles})))))

(subdir
 expected_cpp
 (dynamic_include ../dunes/cpp.dune))

(subdir
 expected_optimized_mir
 (dynamic_include ../dunes/mir.dune))
