(rule
 (targets cppOpenCL.output)
 (deps
  (package stanc)
  (:stanfiles
   (glob_files *.stan)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/run_bin_on_args.exe
    "%{bin:stanc} --use-opencl --print-cpp"
    %{stanfiles}))))

(rule
 (alias runtest)
 (action
  (diff cppOpenCL.expected cppOpenCL.output)))
