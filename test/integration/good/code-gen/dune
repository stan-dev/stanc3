(include cpp.dune)

(subdir
 dunes
 (rule
  (deps
   (:stanfiles ../mother.stan))
  (action
   (with-stdout-to
    lir.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     lir
     "--debug-lir"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles ../mother.stan))
  (action
   (with-stdout-to
    mir.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     mir
     "--debug-mir"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles ../mother.stan))
  (action
   (with-stdout-to
    txmir.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     mir
     "--debug-transformed-mir"
     %{stanfiles})))))

(subdir
 expected_lir
 (dynamic_include ../dunes/lir.dune))

(subdir
 expected_mir
 (dynamic_include ../dunes/mir.dune))

(subdir
 expected_transformed_mir
 (dynamic_include ../dunes/txmir.dune))
