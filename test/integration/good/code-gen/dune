(include cpp.dune)

(subdir
 dunes
 (rule
  (deps
   (:stanfiles ../mother.stan))
  (action
   (with-stdout-to
    lir.inc
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     lir
     "--debug-lir"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles ../mother.stan))
  (action
   (with-stdout-to
    mir.inc
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     mir
     "--debug-mir"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles ../mother.stan))
  (action
   (with-stdout-to
    txmir.inc
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     mir
     "--debug-transformed-mir"
     %{stanfiles})))))

(subdir
 expected_lir
 (dynamic_include ../dunes/lir.inc))

(subdir
 expected_mir
 (dynamic_include ../dunes/mir.inc))

(subdir
 expected_transformed_mir
 (dynamic_include ../dunes/txmir.inc))
