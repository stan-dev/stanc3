(rule
 (targets cpp.inc.gen)
 (deps
  (:stanfiles
   (glob_files *.stan)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/gen_expected_rules.exe
    cpp
    cpp
    --print-cpp
    %{stanfiles}))))

(rule
 (alias update-rules)
 (action
  (diff expected_cpp/dune.inc cpp.inc.gen)))

(include expected_cpp/dune.inc)

