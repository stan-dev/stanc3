(subdir
 dunes
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)
    (glob_files ../*.stanfunctions)))
  (action
   (with-stdout-to
    cpp.inc
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "--standalone-functions --allow-undefined --print-cpp"
     %{stanfiles})))))

(subdir
 expected_cpp
 (dynamic_include ../dunes/cpp.inc))

(rule
 (targets stanc.output)
 (deps
  (package stanc)
  (:stanfiles
   (glob_files *.stan)
   (glob_files *.stanfunctions)))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{project_root}/test/integration/run_bin_on_args.exe
    "%{bin:stanc} --standalone-functions --allow-undefined --auto-format"
    %{stanfiles}))))

(rule
 (alias runtest)
 (action
  (diff stanc.expected stanc.output)))
