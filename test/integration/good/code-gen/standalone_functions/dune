(subdir
 dunes
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan)
    (glob_files ../*.stanfunctions)))
  (action
   (with-stdout-to
    cpp.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     "--standalone-functions --allow-undefined --print-cpp"
     %{stanfiles}))))
 (rule
  (deps
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    output.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--standalone-functions --allow-undefined --auto-format"
     %{stanfiles})))))

(subdir
 expected_pretty
 (dynamic_include ../dunes/output.dune))

(subdir
 expected_cpp
 (dynamic_include ../dunes/cpp.dune))
