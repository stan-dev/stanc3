(subdir
 dunes
 (rule
  (deps
   (sandbox patch_back_source_tree)
   (glob_files ../expected_cpp/*)
   (:stanfiles
    (glob_files ../*.stan)
    (glob_files ../*.stanfunctions)))
  (action
   (with-stdout-to
    cpp.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     cpp
     cpp
     "--standalone-functions --allow-undefined --print-cpp"
     %{stanfiles}))))
 (rule
  (deps
   (sandbox patch_back_source_tree)
   (glob_files ../expected_pretty/*)
   (:stanfiles
    (glob_files ../*.stan*)))
  (action
   (with-stdout-to
    output.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     pretty
     preserve
     "--standalone-functions --allow-undefined --auto-format"
     %{stanfiles})))))

(subdir
 run
 (dynamic_include ../dunes/output.dune)
 (dynamic_include ../dunes/cpp.dune))
