(subdir
 dunes
 (rule
  (deps
   (sandbox patch_back_source_tree)
   (glob_files ../expected_pretty/*)
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    pretty.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--auto-format"
     %{stanfiles})))))

(subdir
 run
 (dynamic_include ../dunes/pretty.dune))
