(subdir
 dunes
 (rule
  (deps
   (glob_files data/*.stan)
   (glob_files functions/*.stan)
   (glob_files gqs/*.stan)
   (glob_files model/*.stan)
   (glob_files parameters/*.stan)
   (glob_files pre/*.stan)
   (glob_files tdata/*.stan)
   (glob_files tparameters/*.stan)
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    pretty.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--include-paths=.. --auto-format --allow-undefined"
     %{stanfiles}))))
 (rule
  (deps
   (glob_files data/*.stan)
   (glob_files functions/*.stan)
   (glob_files gqs/*.stan)
   (glob_files model/*.stan)
   (glob_files parameters/*.stan)
   (glob_files pre/*.stan)
   (glob_files tdata/*.stan)
   (glob_files tparameters/*.stan)
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    inlined.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--include-paths=.. --auto-format --allow-undefined --canonicalize=includes"
     %{stanfiles}))))
 (rule
  (deps
   (glob_files data/*.stan)
   (glob_files functions/*.stan)
   (glob_files gqs/*.stan)
   (glob_files model/*.stan)
   (glob_files parameters/*.stan)
   (glob_files pre/*.stan)
   (glob_files tdata/*.stan)
   (glob_files tparameters/*.stan)
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    stripped.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--include-paths=.. --auto-format --allow-undefined --canonicalize=strip-comments"
     %{stanfiles}))))
 (rule
  (deps
   (glob_files data/*.stan)
   (glob_files functions/*.stan)
   (glob_files gqs/*.stan)
   (glob_files model/*.stan)
   (glob_files parameters/*.stan)
   (glob_files pre/*.stan)
   (glob_files tdata/*.stan)
   (glob_files tparameters/*.stan)
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    stripped_inlined.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     preserve
     "--include-paths=.. --auto-format --allow-undefined --canonicalize=strip-comments,includes"
     %{stanfiles})))))

(subdir
 expected_pretty
 (dynamic_include ../dunes/pretty.dune))

(subdir
 expected_inlined
 (dynamic_include ../dunes/inlined.dune))

(subdir
 expected_stripped
 (dynamic_include ../dunes/stripped.dune))

(subdir
 expected_stripped_inlined
 (dynamic_include ../dunes/stripped_inlined.dune))
