(subdir
 dunes
 (rule
  (deps
   (sandbox patch_back_source_tree)
   (glob_files ../expected_output/*)
   (:stanfiles
    (glob_files ../*.stan)))
  (action
   (with-stdout-to
    output.dune
    (run
     %{project_root}/test/integration/gen_expected_rules.exe
     txt
     "--include-paths=../../included "
     %{stanfiles})))))

(subdir
 run
 (dynamic_include ../dunes/output.dune))
